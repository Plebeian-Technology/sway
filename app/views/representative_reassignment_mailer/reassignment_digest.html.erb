<div style="font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif; max-width: 600px; margin: 0 auto; padding: 24px; color: #1a1a1a; line-height: 1.5;">
  <h2 style="font-size: 20px; font-weight: 700; margin-bottom: 16px;">Representation Update</h2>
  <p style="font-size: 15px; margin-bottom: 20px;">
    Hi <%= @user.full_name.presence || "there" %>,
  </p>
  <p style="font-size: 15px; margin-bottom: 20px;">
    Your elected representation on Sway has been updated following recent election results or redistricting in your area:
  </p>

  <div style="border: 1px solid #e5e5e5; border-radius: 8px; padding: 16px; margin-bottom: 24px; background-color: #fafafa;">
    <ul style="margin: 0; padding-left: 20px; font-size: 14px;">
      <% @reassignments.each do |reassignment| %>
        <li style="margin-bottom: 12px;">
          <% case reassignment.reassignment_type %>
          <% when "successor_seeded" %>
            <strong><%= reassignment.legislator&.full_name %></strong> has succeeded <strong><%= reassignment.previous_legislator&.full_name %></strong> as your representative for <em><%= reassignment.district&.name %></em>.
          <% when "district_changed" %>
            Your voting district has shifted from <em><%= reassignment.previous_district&.name %></em> to <em><%= reassignment.district&.name %></em>, represented by <strong><%= reassignment.legislator&.full_name %></strong>.
          <% when "vacant_seat" %>
            <strong><%= reassignment.previous_legislator&.full_name %></strong>'s term has concluded, and the seat for <em><%= reassignment.district&.name %></em> is currently vacant.
          <% when "vacancy_filled" %>
            <strong><%= reassignment.legislator&.full_name %></strong> has been seated to represent <em><%= reassignment.district&.name %></em>.
          <% else %>
            Your representative for <em><%= reassignment.district&.name %></em> has been updated.
          <% end %>
        </li>
      <% end %>
    </ul>
  </div>

  <div style="text-align: center; margin-bottom: 32px;">
    <a href="https://sway.vote/legislators" style="display: inline-block; background-color: #111827; color: #ffffff; text-decoration: none; padding: 12px 24px; font-size: 14px; font-weight: 600; border-radius: 6px;">
      View Your Representatives
    </a>
  </div>

  <hr style="border: none; border-top: 1px solid #e5e5e5; margin-bottom: 16px;" />
  <p style="font-size: 12px; color: #6b7280; text-align: center; margin: 0;">
    You received this email because you opted into representative updates on Sway.
    <br />
    <a href="https://sway.vote/notifications" style="color: #4b5563; text-decoration: underline;">Manage notification preferences</a>
  </p>
</div>

<!DOCTYPE html>
<html lang="en_US" data-theme="sway" data-theme-mode="auto" class="h-full">
  <head>
    <title>Sway</title>
    <%= favicon_link_tag "/favicon.ico" %>

    <meta name="viewport" content="width=device-width,initial-scale=1">
    <base target="_blank">

    <%= csp_meta_tag %>

    <%= vite_stylesheet_tag 'application' %>
    <%= vite_typescript_tag 'application.tsx', nonce: content_security_policy_nonce %>
  </head>

  <body class="h-full bg-transparent antialiased p-0 m-0 text-foreground">
    <main class="h-full">
      <%= yield %>
      <div id="application-loading" style="display: flex; align-items: center; justify-content: center; width: 100%; height: 100%; min-height: 200px; overflow: hidden;">
        <img src="/images/loading.svg" alt="Loading..." style="max-width: 60px;" />
      </div>
    </main>
  </body>
</html>

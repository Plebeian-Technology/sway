#!/usr/bin/env bash

set -euo pipefail

usage() {
  cat <<'EOF'
Usage: bin/preview-reset [--start]

Removes the local preview SQLite databases and stops the preview containers.
Pass --start to launch `dip preview` after cleanup.
EOF
}

if [ "${1:-}" = "--help" ] || [ "${1:-}" = "-h" ]; then
  usage
  exit 0
fi

if [ $# -gt 1 ] || { [ $# -eq 1 ] && [ "${1:-}" != "--start" ]; }; then
  usage >&2
  exit 1
fi

cd "$(dirname "$0")/.."

dip compose rm -fs preview preview_caddy >/dev/null 2>&1 || true

rm -f \
  storage/preview.sqlite3 \
  storage/preview.sqlite3-* \
  storage/preview_queue.sqlite3 \
  storage/preview_queue.sqlite3-*

echo "Removed preview database files from storage/."

if [ "${1:-}" = "--start" ]; then
  exec dip preview
fi

echo "Run \`dip preview\` to rebuild, migrate, and seed the preview environment."

# See https://help.github.com/articles/ignoring-files for more about ignoring files.
#
# If you find yourself ignoring temporary files generated by your text editor
# or operating system, you probably want to add a global ignore instead:
#   git config --global core.excludesfile '~/.gitignore_global'
#
# SWAY release tracking: frontend OSS-license snapshot. Generated at image-build
# time by `rake sway:licenses:frontend` (regenerated every deploy), so it is
# build output, not source. Run that rake task locally to populate /licenses.
/config/oss-frontend-licenses.json

**/.DS_Store

/*.md
!/lat.md/

/.jules
/.claude
/CLAUDE.local.md
/.agents
/.serena
/.beads
/.gemini
/scratch/

# @lat: [[personal-detail-scanner-design#Why the development storage directory is ignored outright]]
/.dockerdev/storage/
/.gem_rbs_collection
/.playwright-mcp/
/.pnpm-store
/.pytest_cache
/.vscode

# Ignore bundler config.
/.bundle

# Ignore vscode
/.idea
/.vscode

# Ignore sandbox-exec policy files
**/*.sb

# Ignore all environment files (except templates).
#
# Each template is exempted by its exact name rather than by a wildcard such
# as `!/.env*.example`. An untracked `.env.example` sits at the repo root, and
# a broad rule would quietly make that file committable.
/**/**/*.env*
!/.env*.erb
!/.env.development.example
!/.env.test.example
!/.env.preview.example

# Ignore all logfiles and tempfiles.
/log/*
/tmp/*

# What a failing browser spec leaves behind. The rspec container writes here
# through the mount (SCREENSHOT_DIR in .dockerdev/compose.yml), so without this
# every browser failure dirties the working tree with files a careless
# `git add .` would commit.
/spec/screenshots/

# Ignore pidfiles, but keep the directory.
/tmp/pids/*
!/tmp/pids/

# Ignore storage (uploaded files in development and any SQLite databases).
/storage/assets/*
**/*.sqlite3*
/storage/*.db*
!/db/seeds/data/locales.json
!/db/seeds/data/united_states/congress
!/db/seeds/data/united_states/maryland/baltimore
!/db/seeds/data/united_states/maryland/maryland
!/storage/geojson/baltimore-maryland-united_states.geojson
!/db/seeds/data/locales.json
/tmp/storage/*
!/tmp/storage/

/public/assets

# Ignore master key for decrypting credentials and more.
/config/master.key
/config/credentials.yml.enc
/config/cloudflared.key
# Signs the local error collector's dashboard cookies.
# scripts/dip/dev.sh makes one on first run.
/config/rustrak_session.key
# The dashboard login for the same collector, made on first run.
/config/rustrak_admin.key
# API token the rustrak MCP server reads. Referenced by .mcp.json as
# ${RUSTRAK_API_TOKEN}, so the tracked file holds no credential.
/config/rustrak_mcp.key
# Where errors are sent. Names one collector database, so a committed copy
# would point every clone at a project that does not exist on their machine.
/config/rustrak_project.key
/keys/
/config/ssl/

# Vite
/public/vite*
node_modules
# Written by `tsc -p tsconfig.node.json`, which type-checks vite.config.ts.
*.tsbuildinfo
# Vite uses dotenv and suggests to ignore local-only env files. See
# https://vitejs.dev/guide/env-and-mode.html#env-files
*.local

doc/

/app/assets/.well-known
/app/assets/builds/*

litestream/config/*
litestream/dbs/*

wireguard.conf


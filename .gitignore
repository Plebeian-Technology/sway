# subdirectory is ignored rather than the whole cache directory.
lat.md/.cache/parsed/
lat.md/**/.cache/parsed/

# Beads / Dolt files (added by bd init)
.dolt/
*.db
.beads*

mobile/keys/*

/chromedriver

snapshot.txt
# Your own deploy values: the addresses, disk paths and account names that
# belong to your installation and to nobody else's. Copy the tracked
# deploy/config/sway.env.example to make it. Never commit this file — the
# repo is public, and it describes your network.
#
# The `/**/**/*.env*` rule near the top of this file already catches it, and
# catches anything else env-shaped anywhere in the tree. That rule is the
# safety net and must stay. This line is here so the intent is readable at the
# place somebody will look for it.
deploy/config/sway.env

# Two exceptions to that net, both deliberately public:
#   .example    the template, holding placeholder values that cannot work
#   .test.env   the fake values the test suite runs on, so the suite behaves
#               the same on every machine
# Neither holds a credential, an address, or an account name that exists.
!deploy/config/sway.env.example
!deploy/config/sway.test.env

.claude
.pi
.cursor
.opencode
.codex
/prompts


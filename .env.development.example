# Copy this file to .env.development and fill in values.
#
# Every value here is used for development only. Never commit .env.development
# itself — only this example file is tracked.
#
# Values should not be wrapped in quotes.

# ------------------------------------------------------------------
# Required — the app will not boot and seed without these.
# ------------------------------------------------------------------

# Secret for API key generation. Create one with: openssl rand -hex 32
API_KEY_HMAC_SECRET_KEY=

# Phone numbers (digits only) granted admin access. Only admins can create
# Bills in Sway.
ADMIN_PHONES=1234567890

# The seeded development admin user. db:seed reads all of these.
# In multi-word values, use + for spaces (e.g. Sway+Admin).
DEFAULT_PHONE=1234567890
# The seven below were DEFAULT_* until Phase 68. Rename the same seven keys
# in your own untracked .env.development if you already have one.
DEV_ACCOUNT_FULL_NAME=Sway+Admin
DEV_ACCOUNT_STREET=100+Holliday+St
DEV_ACCOUNT_CITY=Baltimore
DEV_ACCOUNT_REGION_CODE=MD
DEV_ACCOUNT_POSTAL_CODE=21202
DEV_ACCOUNT_LATITUDE=39.2908
DEV_ACCOUNT_LONGITUDE=-76.6106

# Sends actual SMS messages via Twilio when set to 'true'
ALLOW_NONPRODUCTION_SMS=

# ------------------------------------------------------------------
# Recommended for development.
# ------------------------------------------------------------------

# Bypass Twilio during registration: any verification code is accepted.
# Leave this set unless you have real Twilio credentials below. Since
# Phase 68, only a recognized word (true/yes/y/1/t) means on -- the word
# "false" or "0" now means off, unlike before. This value already means on
# either way.
SKIP_PHONE_VERIFICATION=1

# ------------------------------------------------------------------
# Optional — enable individual features.
# ------------------------------------------------------------------

# Geocoding user addresses during registration (Maps JavaScript, Places, and
# Geocoding APIs). Without it you cannot complete a real registration.
# https://console.cloud.google.com/apis/library
GOOGLE_MAPS_API_KEY=

# Legislative data sources, used when seeding and refreshing bills/votes.
# https://api.congress.gov/sign-up/
CONGRESS_GOV_API_KEY=
# https://docs.openstates.org/api-v3/ (register via pluralpolicy.com)
OPEN_STATES_API_KEY=

# News lookup
BRAVE_SEARCH_API_KEY=

# Real SMS verification via Twilio Verify. https://console.twilio.com/
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=

# Web push notifications. Generate a pair in the Rails console
# (dip run rails c) with: WebPush.generate_key
# Copy each key in full, including any trailing =.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# LLM bill summaries in development use llama.cpp running on the host.
# The defaults below are already applied; override only if your
# llama-server listens somewhere else.
# LLAMACPP_BASE_URL=http://host.docker.internal:8888/v1
# LLAMACPP_MODEL=local

# ------------------------------------------------------------------
# Local error collector. Optional. See docs/operations.md.
# ------------------------------------------------------------------

# Create a project in the dashboard at http://127.0.0.1:8483, then paste its
# DSN in both forms. The browser uses the published port; the Rails container
# reaches the same collector over the compose network. Empty means no
# reporting. A DSN naming any other machine is refused, not used.
VITE_RUSTRAK_DSN=
RUSTRAK_DSN=

# email:password for the dashboard login, created on first boot. Pick a real
# password — never the one in Rustrak's own documentation.
RUSTRAK_SUPERUSER=

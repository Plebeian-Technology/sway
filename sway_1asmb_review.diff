@@ -0,0 +1,27 @@
+require "rails_helper"
+
+RSpec.describe BillScoreDistrictResource, type: :serializer do
+  describe "#for and #against percentages" do
+    it "returns counts when below the ten-voter minimum" do
+      district = create(:district)
+      score = create(:bill_score, for: 5, against: 4)
+      district_score = create(:bill_score_district, bill_score: score, district: district, for: 5, against: 4)
+      
+      resource = BillScoreDistrictResource.new(district_score).serializable_hash
+      expect(resource[:reached_ten_voter_minimum]).to be false
+      expect(resource[:for]).to eq(5)
+      expect(resource[:against]).to eq(4)
+    end
+
+    it "returns percentages when at or above the ten-voter minimum" do
+      district = create(:district)
+      score = create(:bill_score, for: 6, against: 5)
+      district_score = create(:bill_score_district, bill_score: score, district: district, for: 6, against: 4)
+      
+      resource = BillScoreDistrictResource.new(district_score).serializable_hash
+      expect(resource[:reached_ten_voter_minimum]).to be true
+      expect(resource[:for]).to eq(60) # 6 / (6+4) = 0.6
+      expect(resource[:against]).to eq(40) # 4 / (6+4) = 0.4
+    end
+  end
+end

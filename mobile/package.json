{
  "name": "sway-mobile",
  "version": "1.0.0",
  "private": true,
  "main": "index.js",
  "keywords": [],
  "author": "",
  "license": "AGPL-3.0-or-later",
  "scripts": {
    "start": "EXPO_PUBLIC_API_URL=https://localhost:3333 scripts/with-vault-env.sh APPLE_BUNDLE_ID -- expo start --dev-client",
    "ios": "scripts/xcode-node-env.sh && EXPO_PUBLIC_API_URL=https://localhost:3333 scripts/with-vault-env.sh APPLE_BUNDLE_ID -- expo run:ios",
    "ios:dev": "scripts/xcode-node-env.sh && scripts/with-vault-env.sh APPLE_BUNDLE_ID EXPO_PUBLIC_DEV_TUNNEL_HOST -- sh -c 'EXPO_PUBLIC_API_URL=https://$EXPO_PUBLIC_DEV_TUNNEL_HOST exec expo run:ios'",
    "android": "EXPO_PUBLIC_API_URL=https://localhost:3333 scripts/with-vault-env.sh APPLE_BUNDLE_ID -- expo run:android",
    "android:dev": "scripts/with-vault-env.sh APPLE_BUNDLE_ID EXPO_PUBLIC_DEV_TUNNEL_HOST -- sh -c 'EXPO_PUBLIC_API_URL=https://$EXPO_PUBLIC_DEV_TUNNEL_HOST exec expo run:android'",
    "android:dev:device": "scripts/with-vault-env.sh APPLE_BUNDLE_ID EXPO_PUBLIC_DEV_TUNNEL_HOST -- sh -c 'EXPO_PUBLIC_API_URL=https://$EXPO_PUBLIC_DEV_TUNNEL_HOST exec expo run:android --device'",
    "build:ios": "scripts/with-vault-env.sh APPLE_BUNDLE_ID APPLE_TEAM_ID EAS_PROJECT_ID EXPO_OWNER SENTRY_DSN_MOBILE SENTRY_AUTH_TOKEN SENTRY_ORG SENTRY_PROJECT -- eas build --local --profile production --platform ios",
    "build:android": "scripts/with-vault-env.sh APPLE_BUNDLE_ID APPLE_TEAM_ID EAS_PROJECT_ID EXPO_OWNER SENTRY_DSN_MOBILE SENTRY_AUTH_TOKEN SENTRY_ORG SENTRY_PROJECT -- eas build --local --profile production --platform android",
    "build:local": "scripts/with-vault-env.sh APPLE_BUNDLE_ID APPLE_TEAM_ID EAS_PROJECT_ID EXPO_OWNER SENTRY_DSN_MOBILE SENTRY_AUTH_TOKEN SENTRY_ORG SENTRY_PROJECT -- eas build --local",
    "release:ios": "scripts/release.sh ios",
    "release:android": "scripts/release.sh android",
    "screenshots:ios": "scripts/capture-screenshots.sh ios",
    "screenshots:android": "scripts/capture-screenshots.sh android",
    "credentials:write": "scripts/write-credentials-json.sh",
    "upload:ios": "scripts/upload-ios.sh",
    "upload:android": "scripts/with-vault-env.sh APPLE_BUNDLE_ID -- scripts/upload-android.rb",
    "asc": "scripts/with-vault-env.sh APP_STORE_CONNECT_API_KEY_ID APP_STORE_CONNECT_ISSUER_ID -- scripts/asc.rb",
    "test": "TZ=UTC jest",
    "test:ci": "TZ=UTC jest --ci --forceExit",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "typecheck": "tsc --noEmit",
    "prebuild": "scripts/with-vault-env.sh APPLE_BUNDLE_ID -- expo prebuild && scripts/xcode-node-env.sh",
    "clean:ios": "scripts/with-vault-env.sh APPLE_BUNDLE_ID -- expo prebuild --platform ios --clean && scripts/xcode-node-env.sh"
  },
  "dependencies": {
    "@rails/actioncable": "^8.0.0",
    "@react-native-community/netinfo": "^11.0.0",
    "@react-navigation/drawer": "~7.13.10",
    "@react-navigation/native": "^7.0.0",
    "@react-navigation/native-stack": "^7.0.0",
    "@sentry/react-native": "7.11.0",
    "expo": "^55.0.31",
    "expo-build-properties": "^55.0.18",
    "expo-constants": "^55.0.17",
    "expo-font": "55.0.8",
    "expo-haptics": "^55.0.18",
    "expo-linking": "^55.0.17",
    "expo-notifications": "55.0.27",
    "expo-secure-store": "55.0.18",
    "expo-splash-screen": "55.0.25",
    "expo-sqlite": "55.0.20",
    "expo-status-bar": "^55.0.0",
    "expo-system-ui": "^55.0.22",
    "expo-web-browser": "55.0.20",
    "lucide-react-native": "^1.0.0",
    "mdast-util-from-markdown": "^2.1.0",
    "mdast-util-gfm": "^3.1.0",
    "micromark-extension-gfm": "^3.0.0",
    "nativewind": "4.2.2",
    "react": "19.2.0",
    "react-native": "0.83.10",
    "react-native-css-interop": "0.2.2",
    "react-native-gesture-handler": "~2.30.1",
    "react-native-google-places-sdk": "0.4.0",
    "react-native-passkey": "^3.3.3",
    "react-native-reanimated": "4.2.1",
    "react-native-safe-area-context": "~5.6.2",
    "react-native-screens": "~4.23.0",
    "react-native-svg": "15.15.3",
    "react-native-url-polyfill": "3.0.0",
    "react-native-worklets": "0.7.4"
  },
  "devDependencies": {
    "@babel/core": "^7.25.0",
    "@babel/plugin-transform-react-jsx": "^7.25.0",
    "@babel/runtime": "^7.25.0",
    "@testing-library/jest-native": "^5.4.0",
    "@testing-library/react-native": "^13.0.0",
    "@types/jest": "^29.5.0",
    "@types/mdast": "^4.0.4",
    "@types/node": "25.9.1",
    "@types/rails__actioncable": "8.0.3",
    "@types/react": "~19.2.0",
    "babel-preset-expo": "^55.0.0",
    "eslint-plugin-expo": "^1.1.0",
    "jest-expo": "^55.0.22",
    "oxlint": "^1.72.0",
    "tailwindcss": "^3.4.0",
    "typescript": "~5.9.0"
  },
  "pnpm": {}
}

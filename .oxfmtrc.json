{
    "$schema": "./node_modules/oxfmt/configuration_schema.json",
    "trailingComma": "all",
    "tabWidth": 4,
    "printWidth": 120,
    "singleQuote": false,
    "bracketSpacing": true,
    "arrowParens": "always",
    "semi": true,
    "sortPackageJson": true,
    "ignorePatterns": [
        ".agents/",
        ".beads/",
        ".bundle/",
        ".claude/",
        ".dockerdev/",
        ".gem_rbs_collection/",
        ".github/",
        ".husky/",
        ".jules/",
        ".kamal/",
        ".playwright-mcp/",
        ".pnpm-store/",
        ".pytest_cache/",
        ".rubocop/",
        ".serena/",
        ".vscode/",
        "bin/",
        "db/migrate/",
        "docker/",
        "log/",
        "node_modules/",
        "/public/",
        "scripts/",
        "sorbet/",
        "storage/",
        "tmp/",
        "vendor/",
        "db/schema.rb",
        "package.json",
        "package-lock.json",
        "yarn.lock",
        "pnpm-lock.yaml",
        "pnpm-workspace.yaml",
        "Gemfile.lock",
        "**/**/node_modules",
        "**/build/**",
        "**/dist/**",
        "**/lib/**",
        "**/*.log",
        "**/*.rbs",
        "**/*.rb",
        "**/*.rake",
        "**/*.builder",
        "**/Gemfile",
        "**/Gemfile.lock",
        "**/Rakefile",
        "**/config.ru",
        "**/*.toml",
        "**/*.lock",
        "**/*.md",
        "coverage/",
        "legislation/",
        "eval/",
        ".beads/",
        "mobile/.expo/",
        "mobile/ios/",
        "mobile/android/",
        "mobile/patches/*"
    ]
}

# Copy this file to .env.test and fill in values. Never commit .env.test.
# No quotes around values. The rspec container loads it, so a key missing here
# is a key missing from every spec run.

# ------------------------------------------------------------------
# Required — specs fail without these.
# ------------------------------------------------------------------

# openssl rand -hex 32. ApiKey raises when unset or blank.
API_KEY_HMAC_SECRET_KEY=

# Sway::Settings.dev_login reads each of these seven with no default in
# development and test, so a missing one stops the app booting, naming
# every missing one together. Use + for spaces. These match the Geocoder
# stub in spec/rails_helper.rb. The seven were DEFAULT_* until Phase 68 --
# rename the same seven keys in your own untracked .env.test if you already
# have one.
DEV_ACCOUNT_FULL_NAME=Sway+Admin
# Baltimore City Hall
DEV_ACCOUNT_STREET=100+Holliday+St
DEV_ACCOUNT_CITY=Baltimore
DEV_ACCOUNT_REGION_CODE=MD
DEV_ACCOUNT_POSTAL_CODE=21202
DEV_ACCOUNT_LATITUDE=39.29099283082182
DEV_ACCOUNT_LONGITUDE=-76.61057130320664

# Sends actual SMS messages via Twilio when set to 'true'
ALLOW_NONPRODUCTION_SMS=

# ------------------------------------------------------------------
# Recommended for test.
# ------------------------------------------------------------------

# Any verification code is accepted. The provisioner refuses to run outside
# development and test. Since Phase 68, only a recognized word
# (true/yes/y/1/t) means on -- the word "false" or "0" now means off,
# unlike before. This value already means on either way.
SKIP_PHONE_VERIFICATION=true

# Digits only, comma separated. Empty means no admin.
ADMIN_PHONES=

# ------------------------------------------------------------------
# Optional — only for specs that reach the real service. Most stub at the
# HTTP seam or replay a VCR cassette.
# ------------------------------------------------------------------

# https://api.congress.gov/sign-up/
CONGRESS_GOV_API_KEY=

# rails_helper.rb stubs Geocoder for the whole suite.
GOOGLE_MAPS_API_KEY=
VITE_GOOGLE_MAPS_API_KEY=

# spec/support/twilio_double.rb stands in for these normally.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=

# WebPush.generate_key in the Rails console. Copy in full, trailing = included.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# ------------------------------------------------------------------
# In .env.test but no reader found (searched app/ lib/ config/ spec/ mobile/
# .github/, 2026-08-10; confirmed against Phase 68's 53-name declared
# enumeration, spec/lib/sway/settings_spec.rb, 2026-08-17). Removing them
# is planned in the backlog. Do not add new uses.
#
#   DEFAULT_USER_EMAIL              no reference anywhere. The provisioner
#                                   builds the address as "#{phone}@sway.vote".
#   GOOGLE_RECAPTCHA_SECRET_KEY     no reference anywhere.
#   VITE_GOOGLE_RECAPTCHA_SITE_KEY  only in config/deploy.yml (production).
#   VITE_CLOUDFLARE_TURNSTILE_SITE_KEY
#                                   only in config/deploy.yml (production).
#   SWAY_DATABASE_PASSWORD          config/database.yml has no password line
#                                   at all today (Sway runs SQLite) -- the
#                                   name survives only at
#                                   spec/system/browser_error_reporting_spec.rb:15,
#                                   a comment on running one spec by hand, and
#                                   spec/support/env_credential_scanner.rb's
#                                   own list of names to scan for. Neither is
#                                   a read.
# ------------------------------------------------------------------

# ------------------------------------------------------------------
# Local error collector. Optional in test.
# ------------------------------------------------------------------

# Leave empty and no errors are reported. A DSN naming anything but this
# machine is refused, not used. See docs/operations.md.
RUSTRAK_DSN=
VITE_RUSTRAK_DSN=

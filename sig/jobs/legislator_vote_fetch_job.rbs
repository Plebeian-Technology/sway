# Per-bill dispatcher for legislator-vote ingestion.
# Dispatches to Congress/OpenStates/Baltimore services based on sway_locale.
# (Phase 62 review IN-06: the Plan 04→05 deploy-gap runtime guard was removed —
# Plan 05 shipped and the Baltimore service is unconditionally available.
# force_refresh is a retained no-op kwarg for deploy-window wire-compat — IN-05.)
class LegislatorVoteFetchJob < ApplicationJob

  # Solid Queue concurrency control — coalesces duplicate enqueues for the
  # same bill_id (concurrency_key #legislator_votes_<bill_id>).
  def self.limits_concurrency: (?to: Integer, ?key: ^(*untyped, **untyped) -> String, ?on_conflict: Symbol) -> void

  # Phase 62 r3-iter2 WR-01: shared synchronous dispatch — called by #perform
  # and by lib/tasks/sway_legislator_votes.rake directly (bypassing the job's
  # rescue_from/retry_on surface so errors propagate to the rake's D-29/D-30
  # rescue).
  def self.run_service_for: (Integer bill_id) -> void

  def perform: (Integer bill_id, ?force_refresh: bool) -> void
end

# Phase 62 review WR-03: one-off idempotent retag of the pre-Phase-62
# sponsor-inferred synthetic vote corpus (rows provably not real roll-calls
# get inferred: true). See app/jobs/retag_inferred_legislator_votes_job.rb
# for the full contract.
class RetagInferredLegislatorVotesJob < ApplicationJob
  SPONSOR_INFERENCE_SOURCES: Array[String]

  # Solid Queue concurrency control — global single-flight guard so concurrent
  # puma + bin/jobs boots each enqueue collapse to one run.
  def self.limits_concurrency: (?to: Integer, ?key: ^(*untyped, **untyped) -> String, ?on_conflict: Symbol) -> void

  def perform: () -> void

  private

  def retag_baltimore_rows: () -> Integer

  def retag_congress_and_maryland_rows: () -> void

  def bill_ids_with_roll_call_pointer: () -> RollCall::ActiveRecord_Relation
end

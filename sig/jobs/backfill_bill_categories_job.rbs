# Phase 60 R9: idempotent categorize-only backfill job.
# See app/jobs/backfill_bill_categories_job.rb for the full contract.
class BackfillBillCategoriesJob < ApplicationJob
  # Solid Queue concurrency control — global single-flight guard so concurrent
  # puma + bin/jobs boots each enqueue collapse to one run.
  def self.limits_concurrency: (?to: Integer, ?key: ^(*untyped, **untyped) -> String, ?on_conflict: Symbol) -> void

  def perform: () -> void

  private

  # @lat: [[boot-time-backfills#Why a stamped bill costs nothing on the next boot]]
  def mark_categories_unmatched!: (Bill bill, Llm::SchemaError error) -> void
end

# Manual extensions for Bill. The rbs_rails-generated file under
# sig/rbs_rails/app/models/bill.rbs covers attribute readers, association
# readers/writers, and ActiveRecord query/relation surface. This file adds
# the hand-written constants + private callback method that rbs_rails does
# not introspect.
#
# Phase 39 D-06 trigger: VOTE_TRIGGER_FIELDS whitelist + after_commit
# field-scoped callback enqueues LegislatorVoteFetchJob.perform_later(id).
class Bill < ApplicationRecord
  def archived_at: () -> ActiveSupport::TimeWithZone?
  def archived_at=: (Time | ActiveSupport::TimeWithZone?) -> (Time | ActiveSupport::TimeWithZone?)
  def require_visible_record: () -> void

  VOTE_TRIGGER_FIELDS: ::Array[::String]

  # Phase 62 Plan 04 (D-14): narrower sibling of VOTE_TRIGGER_FIELDS.
  SCORE_TRIGGER_FIELDS: ::Array[::String]

  # Phase 49 HIGH-2: legislation_pipeline_runs association is generated by rbs_rails
  # in sig/rbs_rails/app/models/bill.rbs — do NOT re-declare here (causes Steep duplicate error).
  # The rbs_rails sig uses LegislationPipelineRun::ActiveRecord_Associations_CollectionProxy.

  # Phase 49 UAT follow-up: latest_legislation_pipeline_run (has_one) is
  # generated by rbs_rails — do NOT re-declare (Steep DuplicatedMethodDefinition:
  # rbs_rails emits association methods directly on the class).

  # Phase 62 Plan 04: latest_bill_interesting_score (has_one) is declared in
  # sig/rbs_rails/app/models/bill.rbs — do NOT re-declare here (same reason).

  # Phase 62 review iter-2 WR-01: `previously_new_record?` declaration removed —
  # the create trigger now uses after_create_commit (Rails' own transaction
  # tracking), so the hand-rolled guard predicate is gone from bill.rb.

  # bill_summary_prompt_snapshot (has_one) is declared here rather than
  # regenerated into sig/rbs_rails/app/models/bill.rbs: regenerating that file
  # reorders every one of its ~500 attribute methods, which is a thousand-line
  # diff for one association. Delete this declaration if the generated file is
  # ever refreshed, or Steep reports a duplicate definition.
  def bill_summary_prompt_snapshot: () -> BillSummaryPromptSnapshot?
  def build_bill_summary_prompt_snapshot: (?Hash[Symbol, untyped] attributes) -> BillSummaryPromptSnapshot
  def create_bill_summary_prompt_snapshot: (?Hash[Symbol, untyped] attributes) -> BillSummaryPromptSnapshot
  def reload_bill_summary_prompt_snapshot: () -> BillSummaryPromptSnapshot?
  def bill_summary_reports: () -> BillSummaryReport::ActiveRecord_Associations_CollectionProxy
  def bill_news_articles: () -> BillNewsArticle::ActiveRecord_Associations_CollectionProxy
  def news_articles: () -> NewsArticle::ActiveRecord_Associations_CollectionProxy
  def news_article_source_snapshots: () -> NewsArticleSourceSnapshot::ActiveRecord_Associations_CollectionProxy
  def news_article_source_uses: () -> NewsArticleSourceUse::ActiveRecord_Associations_CollectionProxy
  def news_article_discovery_requests: () -> NewsArticleDiscoveryRequest::ActiveRecord_Associations_CollectionProxy
  def news_article_testimonies: () -> NewsArticleTestimony::ActiveRecord_Associations_CollectionProxy
  def related_articles: () -> untyped
  def news_testimonies: () -> Array[NewsArticleTestimony]

  def legislative_session: () -> LegislativeSession?
  def legislative_session=: (LegislativeSession?) -> LegislativeSession?
  def legislative_session_id: () -> Integer?
  def legislative_session_id=: (Integer?) -> Integer?
  def build_legislative_session: (?Hash[Symbol, untyped] attributes) -> LegislativeSession
  def create_legislative_session: (?Hash[Symbol, untyped] attributes) -> LegislativeSession
  def reload_legislative_session: () -> LegislativeSession?

  # Migrated from the former sig/shims/model_runtime_methods.rbs monolith
  # (WS7.28): hand-written status enum + query/serializer methods rbs_rails
  # does not introspect.
  class Status
    PASSED: String
    FAILED: String
    COMMITTEE: String
    VETOED: String
  end

  STATUSES: Array[String]

  # A1-CR-02: the path-segment shape external_id must have. Aliased to
  # Legislation::Paths::EXTERNAL_ID_PATTERN rather than re-typed so the model
  # boundary and the path boundary cannot drift apart.
  EXTERNAL_ID_PATTERN: Regexp

  def self.of_the_month: (sway_locale: SwayLocale) -> Bill?
  def self.past_of_the_month: (sway_locale: SwayLocale?) -> Bill::ActiveRecord_Relation
  def self.for_legislative_session: (LegislativeSession? session) -> Bill::ActiveRecord_Relation
  def self.current_session: (?SwayLocale? | Integer? sway_locale) -> Bill::ActiveRecord_Relation
  def self.current_legislative_session: (?SwayLocale? | Integer? sway_locale) -> Bill::ActiveRecord_Relation
  def self.active_sessions_for: (SwayLocale? | Integer? sway_locale) -> Array[LegislativeSession]
  def self.fallback_relation_for_sessions: (Bill::ActiveRecord_Relation base_relation, Array[LegislativeSession] sessions) -> Bill::ActiveRecord_Relation?

  # The words LegislationIngestionService puts in `summary` when a
  # bill arrives with none. Read by BillSummaryPublication too, so both rules
  # match the same string.
  SUMMARY_PLACEHOLDER: String

  # True when the published summary is still the model's own draft,
  # so nobody has revised it. The bill page renders a notice from this.
  def summary_ai_unreviewed?: () -> bool

  def current_published_summary_revision: () -> BillSummaryRevision?
  def restore_summary_revision!: (BillSummaryRevision revision, ?actor: User?, ?news_usage: String?, ?source_uses: Array[untyped]?) -> BillSummaryRevision?

  def vote: -> RollCall?
  def roll_call: -> RollCall?
  def roll_calls: -> RollCall::ActiveRecord_Associations_CollectionProxy
  def active: -> bool?
  def active?: -> bool?
  def notifyable?: -> bool
  def vote_date_time_utc: -> ActiveSupport::TimeWithZone?
  def downcase_status: -> String?

  # A1-CR-02: before_validation. Strips surrounding whitespace only — anything
  # more would silently rewrite which bill a value names.
  def normalize_external_id: () -> void
  def create_default_bill_score: -> BillScore
  def render: (User? current_user, SwayLocale current_sway_locale, ?district_legislator_names: bool) -> Hash[Symbol, untyped]

  private

  def enqueue_legislator_vote_fetch: () -> void

  # Phase 62 Plan 04 (D-14).
  def enqueue_interesting_score_recompute: () -> void

  # Phase 62 review iter-2 WR-01: distinct-name create-commit wrapper.
  def enqueue_interesting_score_recompute_on_create: () -> void

  def cleanup_news_source_snapshots_and_uses: () -> void
end

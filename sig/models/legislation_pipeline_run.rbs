# One row per legislation pipeline run. The header used to call this a mirror of
# runs on a remote Python service; that service was removed and the pipeline now
# runs inside Rails, so these rows are the pipeline's own records.
class LegislationPipelineRun < ApplicationRecord
  # Phase 55 Plan 04 (D-05, Pitfall 5): renamed from FULL_NON_SUMMARY_STAGES.
  # summarize-bill is now in the allowlist as a first-class operator-selectable
  # stage.
  ALLOWED_PIPELINE_STAGES: Array[String]
  TERMINAL_SUCCESS_STATUSES: Array[String]
  PHASE_52_STAGE_STATES: Array[Symbol]
  PHASE_52_NON_TERMINAL_STATES: Array[Symbol]
  TERMINAL_STATUSES: Array[Symbol]
  # HI3-01: single source of truth for `*ing_*` status → DAG stage-name mapping.
  STAGE_STATUS_TO_DAG_NAME: Hash[String, String]
  ACTIVE_STATUSES: Array[String]
  # How old a queued/running row must be before the orphan-delete path will
  # remove it. Read by #orphan? and the orphan_age_candidates scope.
  ORPHAN_AGE_THRESHOLD: ActiveSupport::Duration
  # How long a non-final row may go unwritten before nobody is working on it.
  # Read by #abandoned?, the abandoned_candidates scope, and
  # ReclaimAbandonedPipelineRunsJob.
  ABANDONED_AFTER: ActiveSupport::Duration

  def abandoned?: () -> bool
  def orphan?: () -> bool
  def self.solid_queue_job_exists_for?: (LegislationPipelineRun) -> bool
  # @lat: [[llm-summaries#Batch summarisation#Why resume draws the same line as abandonment]]
  def summary_batch_awaited?: () -> bool
  # @lat: [[llm-summaries#Batch summarisation#Why chunking is a progress decision, not a cost one]]
  def live_summary_batches: () -> Array[PipelineRunSummaryBatch]
  # @lat: [[llm-summaries#Batch summarisation#A batch is read back exactly once]]
  def pending_summary_batches: () -> Array[PipelineRunSummaryBatch]
  def self.maximum: (Symbol | String) -> untyped

  def mark_cancelled!: () -> bool

  # Every bill of this run, in the order the per-bill grid shows, with no
  # "Scoped order is ignored" warning.
  def each_pipeline_run_bill: () { (PipelineRunBill) -> void } -> void

  # Phase 47 D-10: parent linkage for resume / restart audit trail.
  # parent_run (belongs_to) is generated by rbs_rails — do NOT re-declare
  # (Steep DuplicatedMethodDefinition: association methods land on the class).
  def parent_run_id: () -> String?
  def parent_run_id=: (String?) -> String?
  # child_runs (has_many) is generated by rbs_rails — do NOT re-declare.
  def origin: () -> String
  def origin=: (String) -> String

  # Phase 55 Plan 07 (D-15.2): CONTRACT half of expand-then-contract is
  # complete; download_missing_assets is now the sole per-run artifact
  # toggle. Concrete bool per feedback_rbs_avoid_untyped.
  def download_missing_assets: () -> bool
  def download_missing_assets=: (bool) -> bool

  # @lat: [[legislation-pipeline#How a stage resolves its SwayLocale]]
  def effective_sway_locale: () -> SwayLocale?
  def sway_locale: () -> SwayLocale?
  def sway_locale=: (SwayLocale?) -> SwayLocale?
  def sway_locale_id: () -> Integer?
  def sway_locale_id=: (Integer?) -> Integer?

  # @lat: [[rbs-signatures#Why a serialized column's generated signature is wrong]]
  def stages: () -> Array[String]
  def stages=: (Array[String]) -> Array[String]

  # Phase 50 D-05: extended to_builder emits pipeline_run_bills array for
  # all-bills runs (bill_id.blank?) — see model body. Return type stays
  # Jbuilder since the Inertia response calls .attributes! downstream.
  def to_builder: () -> Jbuilder

  # Phase 47 D-10: state machine events for terminal status
  def mark_partial!: () -> bool
  def mark_partial: () -> bool
  def mark_succeeded!: () -> bool
  def mark_succeeded: () -> bool
  def can_mark_partial?: () -> bool
  def can_mark_succeeded?: () -> bool
  def partial?: () -> bool
  def succeeded?: () -> bool

  # State machine events for the queued -> running -> failed/cancelled path.
  def start_running!: () -> bool
  def start_running: () -> bool
  def can_start_running?: () -> bool
  def mark_failed!: () -> bool
  def mark_failed: () -> bool
  def can_mark_failed?: () -> bool
  def can_mark_cancelled?: () -> bool

  # The one cable message a status change sends, shared by the after_commit
  # hook and by #reopen_stuck_stage! so the two cannot describe one event two
  # different ways.
  def broadcast_status_change: (from: String?, to: String?) -> void

  # Moves a run whose worker died inside a stage back to "running", writing the
  # Activity Log row and sending the cable message that the state machine would
  # otherwise have sent. Returns false, changing nothing, when the run is not in
  # a per-stage status.
  def reopen_stuck_stage!: () -> bool

  private

  # @lat: [[llm-summaries#Batch summarisation#What the operator sees while a batch is outstanding]]
  def summary_batch_progress: () -> Hash[Symbol, bool | Integer | String | nil]?

  # Phase 45 D-01, D-07: stamps SecureRandom.uuid on idempotency_key before_create.
  # Returns String? because idempotency_key may already be set (idempotent guard).
  def assign_idempotency_key: () -> String?

  # Phase 52 Plan 11 follow-up (UAT Test 2): self-populates remote_run_id with
  # SecureRandom.uuid on create when blank. Idempotent guard preserves any
  # externally-supplied value, so returns String?.
  def assign_remote_run_id: () -> String?

  # Phase 52 Plan 11 follow-up (UAT Test 2): keep PipelineRunStage rows in
  # lock-step with the run-level state machine. Called from after_transition
  # any => any inside the transition's DB transaction.
  def sync_pipeline_run_stage: (untyped transition) -> void
end

# @lat: [[rbs-signatures#Why a declaration sometimes belongs on the Relation]]
class PipelineRunBill::ActiveRecord_Associations_CollectionProxy
  def find_each: (?batch_size: Integer, ?start: Integer, ?finish: Integer, ?error_on_ignore: bool, ?cursor: Symbol | Array[Symbol], ?order: Symbol | Array[Symbol]) { (PipelineRunBill) -> void } -> nil
               | (?batch_size: Integer, ?start: Integer, ?finish: Integer, ?error_on_ignore: bool, ?cursor: Symbol | Array[Symbol], ?order: Symbol | Array[Symbol]) -> Enumerator[PipelineRunBill, nil]
end

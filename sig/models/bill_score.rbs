# Manual extensions for BillScore. Schema-derived accessors live in the
# rbs_rails-generated sig/rbs_rails/app/models/bill_score.rbs; this file holds
# the hand-written instance methods (migrated from the former
# sig/shims/model_runtime_methods.rbs monolith, WS7.28).
class BillScore < ApplicationRecord
    def sway_locale: -> SwayLocale
    def to_builder_with_user: (User? user, ?user_districts: Array[District]?) -> Jbuilder
    def comparison_suppressed?: -> bool
    def voters_needed: -> Integer
    def visible_for: -> Integer?
    def visible_against: -> Integer?
end

# Phase 61 Plan 01 — hand-written overlay for OrganizationFollow.
# rbs_rails covers attribute readers + user/organization associations under
# sig/rbs_rails/app/models/organization_follow.rbs.
# After migration, regenerate that file with: bundle exec rbs-rails generate
#
# This file declares the Phase 61 additions:
#   D-15: notification_cadence enum predicates + class scopes
#   D-14: muted_for? predicate (NOTIFY-set helper)
#   D-15: seed_attrs_from class method (seeds defaults from User global columns)
#
# NOTE: do NOT re-declare rbs_rails-generated association/column readers here
# (Steep DuplicatedMethodDefinition: rbs_rails emits attribute methods on the class).
class OrganizationFollow < ApplicationRecord
  # Phase 61 D-15: notification_cadence enum-generated predicate methods.
  # Generated by `enum :notification_cadence, {every_change: 0, daily: 1, weekly: 2}`.
  def every_change?: () -> bool

  def daily?: () -> bool

  def weekly?: () -> bool

  # Phase 61 D-15: notification_cadence enum-generated class scope methods.
  def self.every_change: () -> OrganizationFollow::ActiveRecord_Relation

  def self.daily: () -> OrganizationFollow::ActiveRecord_Relation

  def self.weekly: () -> OrganizationFollow::ActiveRecord_Relation

  # Phase 61 D-14: muted predicate.
  # Returns true when the follow row has the matching event-type notification disabled.
  # IN-02: an unknown change_type returns true (fail CLOSED — notifies no one),
  # matching the member-no-row branch in Organization#notifiable_follower_set_for.
  # Takes Symbol (not the literal union): callers iterate Array[Symbol] change
  # sets and the method handles any symbol via the fail-closed else branch.
  def muted_for?: (Symbol change_type) -> bool

  # Phase 61 D-15: seed helper — returns a hash of per-follow preference attrs
  # seeded from the user's global default columns. Used by OrganizationFollowsController.
  def self.seed_attrs_from: (User user) -> Hash[Symbol, untyped]
end

# Phase 32 Plan 09 (D-08) — manual extensions for the Organization model.
# rbs_rails covers attribute readers and base associations (icon_url, name,
# sway_locale, sway_locale_id, members, etc.) under
# sig/rbs_rails/app/models/organization.rbs. This file holds the hand-written
# additions: the PUBLIC_FIELDS constant, the to_builder/to_public_json
# serializers, plus the positions/to_simple_builder readers and the
# self.mirrors_external_asset singleton decl (migrated from the former
# sig/shims/model_runtime_methods.rbs monolith, WS7.28).
#
# `self.mirrors_external_asset` is load-bearing: sig/models/concerns/
# mirrors_external_asset.rbs delegates the singleton call sites to this decl.
#
# Phase 61 D-14 — notifiable_follower_set_for (NOTIFY set with mute filtering
# + member-no-row defaults).
class Organization < ApplicationRecord
  PUBLIC_FIELDS: Array[Symbol]

  def self.mirrors_external_asset: (attachment_name: String, url_column: String) -> void

  # organization_follows / followers associations are generated by rbs_rails —
  # do NOT re-declare (Steep DuplicatedMethodDefinition: rbs_rails emits
  # association methods on the class).
  def positions: -> OrganizationBillPosition::ActiveRecord_Associations_CollectionProxy
  def article_bills: () -> ArticleBill::ActiveRecord_Associations_CollectionProxy
  def to_simple_builder: -> Jbuilder
  def to_builder: -> Jbuilder
  def mirrored_icon_url: () -> String?
  # managed_on_sway: nil reads it from the database.
  def to_public_json: (?managed_on_sway: bool?) -> Hash[Symbol, untyped]

  # Ids among org_ids with at least one active membership, in one query.
  def self.managed_on_sway_ids: (Array[Integer] org_ids) -> Array[Integer]

  # Phase 61 D-14 — NOTIFY set: [user_id, cadence] tuples excluding muted followers
  def notifiable_follower_set_for: (Array[Symbol] change_types) -> Array[[Integer, String]]
end

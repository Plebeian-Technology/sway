# Hand-authored RBS sig for PipelineRunStage.
# Covers state-machine helpers (D-21) and JSON column return types (D-22).
# Regenerate rbs_rails sig with: bundle exec rbs_rails all
class PipelineRunStage < ApplicationRecord
  # State predicates (state_machines-activerecord dynamic methods)
  def pending?: () -> bool
  def running?: () -> bool
  def succeeded?: () -> bool
  def failed?: () -> bool
  def skipped?: () -> bool
  def cancelled?: () -> bool

  # Bang transitions — raise StateMachines::InvalidTransition on illegal paths (D-21)
  def start_running!: () -> bool
  def mark_succeeded!: () -> bool
  def mark_failed!: () -> bool
  def mark_skipped!: () -> bool
  def mark_cancelled!: () -> bool

  # Non-bang transitions
  def start_running: () -> bool
  def mark_succeeded: () -> bool
  def mark_failed: () -> bool
  def mark_skipped: () -> bool
  def mark_cancelled: () -> bool

  # can_*? predicates
  def can_start_running?: () -> bool
  def can_mark_succeeded?: () -> bool
  def can_mark_failed?: () -> bool
  def can_mark_skipped?: () -> bool
  def can_mark_cancelled?: () -> bool
end

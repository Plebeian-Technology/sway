class User < ApplicationRecord
    class EmailValidator < ActiveModel::EachValidator
        def validate_each: (untyped record, Symbol attribute, untyped value) -> void
        def in_blocklist?: (String email) -> bool
        def prepare: (String email) -> String
    end

    # 68-03 (D-11/D-17): private class method, called from the class body to
    # build ADMIN_PHONES and API_USER_PHONES. Declared without RBS's `private`
    # marker on a singleton method, matching the LegislatorHistoryResource
    # convention (sig/serializers/resources.rbs) for a `class << self; private`
    # method Steep still needs to resolve a receiverless call against.
    def self.phone_list_from_credential: (String name) -> Array[String]

    MIN_PASSKEY_COUNT: Integer
    ADMIN_PHONES: Array[String]
    API_USER_PHONES: Array[String]
    THEME_MODES: Array[String]

    # Phase 61 D-15: allowlist for cascade_org_pref_off! (T-61-01-01 mitigation)
    CASCADABLE_FOLLOW_COLUMNS: Array[Symbol]

    def sway_locales: -> Array[SwayLocale]
    def default_sway_locale: -> SwayLocale?
    def user_legislators_by_locale: (SwayLocale? sway_locale) -> Array[UserLegislator]
    def legislators: (SwayLocale sway_locale) -> Array[Legislator]
    def districts: (SwayLocale sway_locale) -> Array[District]
    def email_sendable?: -> bool
    def as_json: (?untyped options) -> Hash[(String | Symbol), untyped]
    def to_builder: -> Jbuilder
    def revoke_all_devices!: () -> void
    def is_sway_admin?: -> bool
    def sway_admin?: -> bool
    def is_sway_admin: -> bool
    def monitoring_admin?: -> bool
    def beszel_url: -> String?
    def user_address_changes: () -> ::UserAddressChange::ActiveRecord_Associations_CollectionProxy
    def news_article_discovery_requests: () -> NewsArticleDiscoveryRequest::ActiveRecord_Associations_CollectionProxy
    # is_admin? aliases is_sway_admin? (sole caller PipelineRunChannel). Declared
    # by hand because the users.is_admin column — which rbs_rails derived this
    # predicate from — was dropped in WS5.17.
    def is_admin?: -> bool
    def is_admin: -> bool
    def is_sway_api_user?: -> bool
    def has_sway_passkey?: -> bool
    def registered?: -> bool
    def complete_registration!: -> void
    def add_pending_representative_locale: (SwayLocale sway_locale) -> void
    def remove_pending_representative_locale: (SwayLocale sway_locale) -> void
    def create_user_invite_url: -> UserInviteLink?
    def invite_url: -> String?

    def processing?: -> bool
    def completed?: -> bool
    def complete!: (?bool run_action) -> void
    def mark_failed!: -> void

    # Phase 61 D-15: org_position_cadence_default enum predicate methods.
    # Generated by `enum :org_position_cadence_default, {every_change: 0, daily: 1, weekly: 2}`.
    def every_change?: () -> bool
    def daily?: () -> bool
    def weekly?: () -> bool

    # Phase 61 D-15 / REQ-6: asymmetric global-OFF cascade primitive.
    # IN-03: accepts a Symbol OR String column name (normalized via to_sym).
    # Raises ArgumentError if column is not in CASCADABLE_FOLLOW_COLUMNS.
    def cascade_org_pref_off!: (Symbol | String column) -> void
    def apply_org_notification_defaults!: (Hash[Symbol, untyped] attrs) -> void
    def record_funnel_event: (String | Symbol step, ?Hash[untyped, untyped]? metadata) -> RegistrationFunnelEvent
    def transient_funnel_metadata: () -> Hash[(Symbol | String), untyped]?
    def transient_funnel_metadata=: (Hash[(Symbol | String), untyped]?) -> void

    # received_organization_invites is generated by rbs_rails — do NOT re-declare
    # (Steep DuplicatedMethodDefinition: rbs_rails emits association methods on the class).
end

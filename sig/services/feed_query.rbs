class FeedQuery
  DEFAULT_PER_PAGE: Integer

  class Item < Data
    attr_reader kind: String
    attr_reader key: String
    attr_reader occurred_at: ActiveSupport::TimeWithZone | Time
    attr_reader sway_locale: SwayLocale?
    attr_reader bill: Bill?
    attr_reader legislator: Legislator?
    attr_reader legislators: Array[Legislator]?
    attr_reader organization_bill_position: OrganizationBillPosition?
    attr_reader user_vote: UserVote?
    attr_reader legislator_vote: LegislatorVote?

    def initialize: (
      kind: String,
      key: String,
      occurred_at: ActiveSupport::TimeWithZone | Time,
      ?sway_locale: SwayLocale?,
      ?bill: Bill?,
      ?legislator: Legislator?,
      ?legislators: Array[Legislator]?,
      ?organization_bill_position: OrganizationBillPosition?,
      ?user_vote: UserVote?,
      ?legislator_vote: LegislatorVote?
    ) -> void

    def self.new: (
      kind: String,
      key: String,
      occurred_at: ActiveSupport::TimeWithZone | Time,
      ?sway_locale: SwayLocale?,
      ?bill: Bill?,
      ?legislator: Legislator?,
      ?legislators: Array[Legislator]?,
      ?organization_bill_position: OrganizationBillPosition?,
      ?user_vote: UserVote?,
      ?legislator_vote: LegislatorVote?
    ) -> Item
  end

  @user: User
  @cursor: String?
  @per_page: Integer
  @query: String?
  @matching_items: Array[Item]?
  @page_result: [Array[Item], String?]?
  @declared_locales: Array[SwayLocale]
  @term_starts_by_locale_id: Hash[Integer, Date]
  @active_user_legislators: Array[UserLegislator]

  def self.term_start_on: (SwayLocale sway_locale) -> Date

  def initialize: (user: User, ?cursor: String?, ?per_page: Integer, ?query: String?) -> void

  def items: () -> Array[Item]
  def next_cursor: () -> String?
  def match_count: () -> Integer

  private

  def matching_items: () -> Array[Item]
  def page_result: () -> [Array[Item], String?]
  def build_items: () -> Array[Item]
  def filter_by_query: (Array[Item] items) -> Array[Item]
  def item_matches_query?: (Item item, String query) -> bool
  def searchable_texts: (Item item) -> Array[String]
  def user_joined_item: () -> Item
  def active_user_legislators: () -> Array[UserLegislator]
  def representatives_found_item: () -> Item?
  def declared_locales: () -> Array[SwayLocale]
  def term_starts_by_locale_id: () -> Hash[Integer, Date]
  def legislative_term_began_items: () -> Array[Item]
  def bill_of_the_month_released_items: () -> Array[Item]
  def legislator_voted_items: () -> Array[Item]
  def legislator_vote_occurred_at: (Bill bill, Legislator legislator, LegislatorVote legislator_vote) -> (ActiveSupport::TimeWithZone | Time)
  def senator?: (Legislator legislator) -> bool
  def organization_position_taken_items: () -> Array[Item]
  def bill_in_current_term?: (Bill bill, Date term_start) -> bool
  def paginate: (Array[Item] sorted_items) -> [Array[Item], String?]
  def filter_after_cursor: (Array[Item] sorted_items) -> Array[Item]
  def encode_cursor: (Item item) -> String
  def decode_cursor: (String? cursor) -> [Time, String]?
end

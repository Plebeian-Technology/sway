  def self.call: (?sway_locale: SwayLocale?, ?locale: SwayLocale?, ?client: Legistar::Client?, ?legistar_client: Legistar::Client?, ?detail_url_resolver: untyped, ?resolver: untyped, ?logger: untyped, ?raise_on_failure: bool, **untyped) -> Hash[Symbol, Integer]

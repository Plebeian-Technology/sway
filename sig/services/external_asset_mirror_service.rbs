class ExternalAssetMirrorService
    STORAGE_HOST: "storage.googleapis.com"

    ASSETS_BUCKET: String

    MAX_DOWNLOAD_BYTES: Integer

    ALLOWED_IMAGE_CONTENT_TYPES: Array[String]

    RESERVED_INTERNAL_RANGES: Array[IPAddr]

    def self.call: (record: ApplicationRecord, attachment_name: Symbol, url_column: Symbol) -> Symbol

    private

    def self.attach_download: (ApplicationRecord record, Symbol attachment_name, String final_url, String source_url) -> bool

    def self.safe_normalize_url: (String url) -> String

    def self.resolve_final_url: (String url, ?max_hops: Integer) -> String?

    def self.redirect_location_for: (String url, ?resolved_ip: String?) -> String?

    def self.absolute_redirect_target: (String base, String location) -> String?

    def self.non_http_url?: (String url) -> bool

    def self.internal_asset_url?: (String url) -> bool

    def self.private_or_local_host?: (String url) -> bool

    def self.resolve_public_ip: (String host) -> String?

    def self.blocked_ip_address?: (String address) -> bool

    def self.host_addresses: (String host) -> Array[String]

    def self.mirror_filename: (Down::DownloadedFile downloaded_file, String source_url) -> String?

    def self.purge_attachment: (ApplicationRecord record, Symbol attachment_name) -> nil
end

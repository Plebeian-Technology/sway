class SwayRegistrationService
    @user: untyped

    @address: untyped

    @sway_locale: untyped

    @legislators: untyped

    @invited_by_id: untyped

    @async: untyped

    @feature: untyped

    @districts: untyped

    @skipped_resolution_errors: ::Array[Seats::UnresolvedSeatError | Seats::OverlapValidator::OverlapError]

    @skipped_term_ids: ::Array[Integer]

    @skipped_legislator_ids: ::Array[Integer]

    include SwayGeocode

    attr_reader address: untyped

    attr_reader sway_locale: untyped

    attr_reader skipped_resolution_errors: ::Array[Seats::UnresolvedSeatError | Seats::OverlapValidator::OverlapError]

    attr_reader skipped_legislator_ids: ::Array[Integer]

    def initialize: (untyped user, untyped address, untyped sway_locale, invited_by_id: untyped, ?async: bool) -> void

    def call: -> (::Array[untyped] | untyped)

    def create_user_legislators: -> ::Array[UserLegislator]

    def district_legislators: -> (untyped | ::Array[untyped] | untyped)

    private

    def locale_wide_candidates: -> ::Array[Legislator]

    def resolve_seat_candidates: (::Array[Legislator] candidates) -> ::Array[Legislator]

    def terms_within_locale: (::Array[LegislatorTerm] terms) -> ::Array[LegislatorTerm]

    def skip_unresolved_terms: (::Array[LegislatorTerm] terms, Seats::UnresolvedSeatError | Seats::OverlapValidator::OverlapError error) -> void

    def unseated_unconfigured_office?: (LegislatorTerm term) -> bool

    def districts: -> untyped

    def find_legislators_from_open_states_geo_endpoint: -> (::Array[untyped] | untyped)

    def create_invite: -> (nil | untyped)
end

# RubyGems ships no type signatures of its own, and the community-maintained
# ones do not describe `Gem::Specification.find_by_name`. It is a real, public
# RubyGems method: it hands back the loaded specification for a gem by name, and
# raises Gem::MissingSpecError when no gem of that name is installed.
#
# spec/config/queue_schema_spec.rb uses it to find where the solid_queue gem
# unpacked itself, so it can compare our copy of the job-table schema against
# the one that gem ships.
module Gem
  class Specification
    def self.find_by_name: (String name, *untyped requirements) -> Gem::Specification

    def gem_dir: () -> String
  end
end

# @lat: [[rbs-signatures#Why the state_machines DSL is declared on Class]]
module StateMachines
    class Machine
        def states: () -> Array[untyped]
    end

    class Transition
        def from: () -> untyped
        def to: () -> untyped
        def event: () -> untyped
    end
end

class Class
    def state_machine:
        (*untyped) -> StateMachines::Machine
        | (*untyped) { (untyped, StateMachines::Transition) -> top? } -> StateMachines::Machine
    def event: (*untyped) -> top | (*untyped) { (untyped, StateMachines::Transition) -> top? } -> top
    def transition: (*untyped) -> top
    def any: (*untyped) -> top
    def before_transition:
        (*untyped) -> top
        | (*untyped) { (untyped, StateMachines::Transition) -> top? } -> top
    def after_transition:
        (*untyped) -> top
        | (*untyped) { (untyped, StateMachines::Transition) -> top? } -> top
    def after_failure:
        (*untyped) -> top
        | (*untyped) { (untyped, StateMachines::Transition) -> top? } -> top
    def has_shortened_urls: (*top args, **top kwargs) -> top
end


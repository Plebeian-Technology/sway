module Open3
    # EnvReadCheck#git_tracked_app_files (68-11) and its spec's git fixture
    # helpers -- a plain two-value capture with no deadline, unlike
    # Sway::Subprocess.capture3, because this check must not depend on
    # anything that reaches for Rails (SwayLogging, on Sway::Subprocess's
    # timeout path) to stay bootable with no Rails environment at all.
    def self.capture2: (*top args, **top kwargs) -> [String, Process::Status]
    def self.capture2e: (*top args, **top kwargs) -> [String, Process::Status]
    def self.capture3: (*top args, **top kwargs) -> [String, String, Process::Status]

    # A-WR-03: Sway::Subprocess needs the four-value form — capture3 has no
    # deadline, and killing a hung child requires access to its wait thread.
    # @lat: [[rbs-signatures#Why a hand-written signature can outrank the standard library's]]
    def self.popen3: (*(String | [String, String]), ?unsetenv_others: bool, ?pgroup: true | Integer, ?umask: Integer, ?close_others: bool, ?chdir: String) -> [IO, IO, IO, Process::Waiter]
end

module InertiaRails
  def self.defer: -> untyped
               | { -> untyped } -> untyped
  def self.once: -> untyped
              | { -> untyped } -> untyped
  # Phase 65 (D-10): the first InertiaRails.optional usage in this codebase
  # (LegislatorsController#index — the lazy History prop).
  def self.optional: -> untyped
                   | { -> untyped } -> untyped

  # @lat: [[lazy-inertia-props#Mobile JSON omission is an explicit request]]
  class BaseProp
    def call: (untyped controller) -> untyped
  end

  class IgnoreOnFirstLoadProp < BaseProp
  end

  class OptionalProp < IgnoreOnFirstLoadProp
  end

  class DeferProp < IgnoreOnFirstLoadProp
  end
end


    class Configuration
        def allowed_origins: () -> Array[String]?
        def allowed_origins=: (Array[String]?) -> Array[String]?
        def rp_name: () -> String?
        def rp_name=: (String) -> String
        def rp_id: () -> String?
        def rp_id=: (String?) -> String?
    end

    class RelyingParty
        def initialize: (*top args, **String | bool | Integer | Array[String] | nil kwargs) -> void
        def options_for_authentication: (*top args, **top kwargs) -> untyped

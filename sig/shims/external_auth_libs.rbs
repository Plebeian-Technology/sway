            (*top args, **top kwargs) -> [untyped, untyped]
            | (*top args, **top kwargs) { (untyped) -> untyped } -> [untyped, untyped]
        def options_for_registration: (*top args, **top kwargs) -> untyped
        def verify_registration: (*top args, **top kwargs) -> untyped

        # 68-10: relying_party_spec.rb reads these three back off the real
        # object #relying_party builds, to prove what the concern actually
        # handed the library rather than what it merely logged.
        def id: () -> String?
        def name: () -> String?
        def allowed_origins: () -> Array[String]?
    end

    class Credential

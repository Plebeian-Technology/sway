  def status=: (("pending" | "active" | "removed" | Symbol)) -> ("pending" | "active" | "removed")

  def pending?: () -> bool
  def active?: () -> bool
  def removed?: () -> bool

  def can_activate?: () -> bool
  def can_remove?: () -> bool

  def activate: () -> bool
  def activate!: () -> bool
  def remove: () -> bool
  def remove!: () -> bool

  def status_events: () -> Array[Symbol]
  def status_name: () -> Symbol

  # Instance methods
  def to_builder: () -> Jbuilder

  private

  def must_not_orphan_org_admin_on_update: () -> void
  def must_not_orphan_org_admin_on_destroy: () -> void
  def __only_active_admin?: () -> bool
end

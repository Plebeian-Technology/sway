            def initialize: (bill: untyped, roll_call_number: untyped, roll_call_chamber: untyped) -> void

            def content_type: -> "application/pdf"

            # r = Faraday.get('https://mgaleg.maryland.gov/2025RS/votes/house/0549.pdf').body
            def do_request: (?year_offset: Integer) -> untyped

            def do_process: -> ::Array[Scraper::LegislatorVote]


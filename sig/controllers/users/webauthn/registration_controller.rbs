module Users
    module Webauthn
        class RegistrationController < ApplicationController
            include VerifiedPhoneSession

            class AlreadyRegistered < StandardError
            end

            ALREADY_REGISTERED_MESSAGE: String
            SIGN_IN_FAILED_MESSAGE: String

            def create: -> untyped

            def callback: -> untyped

            private

            def phone_taken?: (ActiveRecord::RecordInvalid | ActiveRecord::RecordNotUnique error) -> bool

            def sanitized_user_attributes: (untyped attributes, untyped verified_phone) -> untyped

            def read_attribute: (untyped attributes, untyped key) -> untyped

        end
    end
end

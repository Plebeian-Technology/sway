module Users
    module Webauthn
        class UnknownPasskeyError < StandardError
        end

        class SessionsController < ApplicationController
            @phone: untyped

            include Authentication
            include VerifiedPhoneSession
            include OnboardingSafetyNet

            PASSKEY_VERIFICATION_FAILED_MESSAGE: String

            def create: -> untyped

            def discoverable_challenge: -> untyped

            def discoverable_callback: -> untyped

            def callback: -> untyped

            def destroy: -> untyped

            private

            def session_params: -> untyped

            def public_key_credential_params: -> untyped

            def self.session_params: () -> untyped

            def phone: -> untyped

            def verify_valid_phone: -> (nil | untyped)

            def count_create_phone_attempt?: -> bool
        end
    end
end

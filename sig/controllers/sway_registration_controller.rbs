class SwayRegistrationController < ApplicationController
    include OnboardingSafetyNet

    REGISTRATION_UNAVAILABLE_MESSAGE: ::String
    REGISTRATION_NO_REPRESENTATIVES_MESSAGE: ::String
    REGISTRATION_ADDRESS_SWITCH_CONFIRMATION_MESSAGE: ::String
    REGISTRATION_ADDRESS_SWITCH_COOLDOWN_MESSAGE: ::String
    REGISTRATION_ADDRESS_SWITCH_UNAVAILABLE_MESSAGE: ::String
    ADDRESS_NOT_LOCATED_MESSAGE: ::String
    ADDRESS_TEXT_FIELDS: Array[Symbol]
    GEOCODE_FILLED_FIELDS: Array[Symbol]

    @submitted_normalized_key: String?

    @submitted_place_types: Array[String]

    @submitted_coordinates: { latitude: Float?, longitude: Float? }

    def index: -> untyped

    # Finds representatives for the submitted address and reports completion only for active pairings.
    def create: -> untyped

    private

    def holds_representatives?: (User u, ?Address? previous_address) -> bool

    def clear_previous_unlocated_address: (User u, Address? previous_address, Address new_address) -> Array[Legislator]

    def recompute_deactivated_legislator_scores: (User u, Array[Legislator] previous_legislators) -> void

    def render_onboarding_unavailable: () -> void

    def handle_address_switch: (User u, Address previous_address, Address new_address, String return_path) -> untyped

    def address_switch_return_path: (User u) -> String

    def render_geocoding_unavailable: (User u, Address address_instance, StandardError exception, ?redirect: String) -> untyped

    def render_address_switch_unavailable: (User u, Address address_instance, StandardError exception, ?redirect: String) -> untyped

    def report_skipped_locale: (User u, Address address_instance, SwayLocale sway_locale, StandardError exception) -> void

    def wait_for_congress_representatives: (User u, Address address_instance) -> void

    def render_no_representatives: (?redirect: String) -> untyped

    def registered_voter_address_confirmed: -> bool

    def confirm_deactivate_legislators?: -> bool

    def address: -> untyped

    def submitted_place_types: -> Array[String]

    def address_by_normalized_key: -> Address?

    def linked_address_with_submitted_text: -> Address?

    def same_submitted_text?: (Symbol field, Address linked, Address submitted) -> bool

    def submitted_address_attributes: -> Hash[Symbol, untyped]

    def registration_page_props: () -> Hash[Symbol, untyped]

    def submitted_normalized_key: -> String?

    def submitted_text: (Symbol name) -> String

    def submitted_coordinate: (:latitude | :longitude name) -> Float?

    def submitted_coordinates: () -> { latitude: Float?, longitude: Float? }

    def parsed_coordinate: (untyped value, Integer bound) -> Float?

    def sway_registration_params: -> untyped

    # Phase 36-05: dual-format response helper for sway_registration. Web sends
    # Inertia redirect; mobile/JSON gets a status + payload + redirect path
    # envelope.
    def respond_json_or_redirect: (status: Symbol, json: Hash[Symbol, untyped], redirect: String) -> untyped
    def redirect_after_registration_completion: (User user) -> untyped
    def render_address_not_located: (User u, Address address_instance, ?redirect: String) -> untyped
    def address_not_located_outcome?: () -> bool
end

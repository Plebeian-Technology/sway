# Llm::ClaudeAdapter for production bill summaries. The Bitwarden item is named
# exactly ANTHROPIC_API_KEY.
ANTHROPIC_API_KEY=$(kamal secrets extract ANTHROPIC_API_KEY $SECRETS)
# OpenRouter API key consumed by Llm::OpenRouterAdapter for production bill
# summaries and classifications. The Bitwarden item is named exactly
# SWAY_OPEN_ROUTER_API_KEY.
OPENROUTER_API_KEY=$(kamal secrets extract SWAY_OPEN_ROUTER_API_KEY $SECRETS)
BRAVE_SEARCH_API_KEY=$(kamal secrets extract BRAVE_SEARCH_API_KEY $SECRETS)
# Signs and checks the bearer tokens the mobile app uses. The Bitwarden item is
# named exactly API_KEY_HMAC_SECRET_KEY, value from `openssl rand -hex 32`.
#
# CHANGING THIS VALUE INVALIDATES EVERY ISSUED KEY. The digest stored on an
# api_keys row is derived from it, so a new value makes every existing row
# unverifiable and every mobile session dead.
API_KEY_HMAC_SECRET_KEY=$(kamal secrets extract API_KEY_HMAC_SECRET_KEY $SECRETS)
# Keys the digest that stands in for a phone number in rate-limit
# cache rows and the SmsVerificationToken entry. A separate secret from
# API_KEY_HMAC_SECRET_KEY -- see lat.md/explanation/phone-cache-hashing.md. The
# vault item is SWAY_PHONE_CACHE_HMAC_SECRET_KEY, value from
# `openssl rand -hex 32`.
#
# CHANGING THIS VALUE INVALIDATES EVERY EXISTING RATE-LIMIT BUCKET AND
# IN-FLIGHT SMS VERIFICATION TOKEN, the same way rotating API_KEY_HMAC_SECRET_KEY
# above invalidates every issued key.
PHONE_CACHE_HMAC_SECRET_KEY=$(kamal secrets extract SWAY_PHONE_CACHE_HMAC_SECRET_KEY $SECRETS)
# WS0.3: config/deploy.yml env.secret requires GITHUB_TOKEN + GITHUB_REPO
# (Phase 59). Without these extracts Kamal raises "Secret 'GITHUB_TOKEN' not
# found in .kamal/secrets" and a deploy from a clean checkout fails. Both MUST
# exist as items in the Bitwarden vault — provisioning steps in
# docs/kamal-secrets.md; that doc does not record them as created, so verify
# before deploying. If an item is missing, the fetch
# raises in-process and the deploy aborts before anything ships (fail-loud).
# GITHUB_REPO is a non-secret owner/repo slug but travels the same env.secret path.
GITHUB_TOKEN=$(kamal secrets extract GITHUB_TOKEN $SECRETS)
GITHUB_REPO=$(kamal secrets extract GITHUB_REPO $SECRETS)

# The three Active Record encryption keys. Bitwarden items are
# named exactly as the variables are; values come from
# `bin/rails db:encryption:init`.
#
# A LOST KEY CANNOT BE RECOVERED. Every column encrypted under it becomes
# permanently unreadable -- there is no fallback, no re-derivation, and no
# support path. See lat.md/explanation/active-record-encryption-keys.md.
ACTIVE_RECORD_ENCRYPTION_PRIMARY_KEY=$(kamal secrets extract ACTIVE_RECORD_ENCRYPTION_PRIMARY_KEY $SECRETS)
ACTIVE_RECORD_ENCRYPTION_DETERMINISTIC_KEY=$(kamal secrets extract ACTIVE_RECORD_ENCRYPTION_DETERMINISTIC_KEY $SECRETS)
ACTIVE_RECORD_ENCRYPTION_KEY_DERIVATION_SALT=$(kamal secrets extract ACTIVE_RECORD_ENCRYPTION_KEY_DERIVATION_SALT $SECRETS)
APNS_AUTH_KEY_P8=$(kamal secrets extract SWAY_APNS_PRODUCTION_BASE64 $SECRETS)
APNS_KEY_ID=$(kamal secrets extract SWAY_PRODUCTION_APNS_KEY_ID $SECRETS)
APPLE_TEAM_ID=$(kamal secrets extract APPLE_TEAM_ID $SECRETS)
APPLE_BUNDLE_ID=$(kamal secrets extract SWAY_BUNDLE_ID $SECRETS)
FCM_SERVICE_ACCOUNT_JSON=$(kamal secrets extract SWAY_FCM_SERVICE_ACCOUNT_JSON $SECRETS)

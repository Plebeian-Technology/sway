    "scripts": {
        "test": "vitest run",
        "test:watch": "vitest",
        "dev": "vite",
        "start": "vite",
        "build": "vite build --logLevel info",
        "analyze": "source-map-explorer 'public/vite/assets/*.js' --no-border-checks",
        "lint": "oxlint -c .oxlintrc.json",
        "lint:agent": "oxlint -c .oxlintrc.json --format=agent",
        "lint:fix": "oxlint -c .oxlintrc.json --fix",

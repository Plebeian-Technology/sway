        "prepare": "husky",
        "fmt": "oxfmt",
        "fmt:write": "oxfmt --write",
        "fmt:check": "oxfmt --check",
        "tsc": "tsc --project tsconfig.json",
        "typecheck": "tsc --project tsconfig.json",
        "mobile:tokens": "node scripts/extract_sway_tokens.mjs && oxfmt mobile/src/theme/tokens.ts mobile/src/theme/tokens.js",
        "parity:auth": "node mobile/scripts/parity-auth-bootstrap.js",
        "parity:capture:web": "node scripts/capture_parity_evidence_phase38.mjs --web",
        "parity:capture:ios": "node scripts/capture_parity_evidence_phase38.mjs --ios",
        "parity:diff": "node scripts/capture_parity_evidence_phase38.mjs --diff",
        "parity:verify": "bash mobile/scripts/verify-evidence-pack.sh && node mobile/scripts/verify-summary.js",
        "eval:promptfoo": "PROMPTFOO_DISABLE_TELEMETRY=1 PROMPTFOO_DISABLE_UPDATE=1 PROMPTFOO_CONFIG_DIR=\"$PWD/tmp/promptfoo/config\" promptfoo"
    }

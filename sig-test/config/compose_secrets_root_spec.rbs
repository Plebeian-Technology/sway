# Spec-only declarations for spec/config/compose_secrets_root_spec.rb.
#
# Steep cannot see a `let`, so each helper is declared here. Named
# compose_services rather than services because every name here lands on the
# one class Object shared by every spec, and a second declaration of one name
# is a Steep error. compose_env_files is declared in object_spec_methods.rbs.
class Object
  def compose_services: () -> Hash[String, untyped]

  def deploy_config_mounts: () -> Array[[String, String]]

  def git_mounts: () -> Array[[String, String]]
end

# Spec-only declarations for spec/config/production_image_files_spec.rb.
#
# Steep cannot see a `let`, so each helper is declared here. `dockerfile` is
# declared once for both Dockerfile specs, in
# sig-test/config/sentry_sourcemap_guard_spec.rbs.
class Object
  def shipped_ruby: () -> Array[Pathname]

  def paths_ruby_reads: () -> Array[String]

  # The names a `find ... ! -name X` keeps when it prunes app/frontend.
  def preserved_names: () -> Array[String]
end

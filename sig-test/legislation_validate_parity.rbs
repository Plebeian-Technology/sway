# Phase 52 Plan 04: spec-target stubs for the rake-defined constants and
# the spec-only helper module used in spec/lib/tasks/legislation_validate_parity_spec.rb.
#
# These constants live in lib/tasks/legislation_validate_parity.rake (top-level
# scope, as Rake convention) — Steep does not auto-load .rake files so we
# stub them here for the test target.
EXTRACT_TEXT_MIN_COVERAGE: Float
PARSE_SECTIONS_MIN_MATCH: Float
FETCH_METADATA_IDENTITY: bool
DIFF_STRUCTURAL_EQUIVALENCE: bool
FETCH_LAW_PAYLOAD_IDENTITY: bool
FETCH_HEARINGS_PAYLOAD_IDENTITY: bool
BASELINE_DIR: Pathname

module LegislationValidateParitySpecHelpers
  TMP_BASELINE: String
  TMP_RUBY_OUT: String

  def self.write_baseline: (String bill_id, Hash[String, untyped] metadata) -> void
  def self.write_ruby_metadata: (String bill_id, Hash[String, untyped] metadata) -> void
end

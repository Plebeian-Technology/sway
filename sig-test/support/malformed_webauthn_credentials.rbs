module WebAuthn
  class FakeClient
    def initialize: (String origin) -> void
    def create: (challenge: String, rp_id: String, user_verified: bool) -> Hash[String, untyped]
    def get: (challenge: String, rp_id: String, user_verified: bool, sign_count: Integer) -> Hash[String, untyped]
  end

  class PublicKeyCredentialWithAttestation
    def id: () -> String
    def public_key: () -> String
    def sign_count: () -> Integer
  end
end

module MalformedWebauthnCredentials
  ORIGIN: String
  RP_ID: String
  PHONE: String
  WEB_REJECTION_MESSAGE: String
  REGISTRATION_CORRUPTIONS: Hash[String, ^(Hash[String, untyped]) -> Hash[String, untyped]]
  ASSERTION_CORRUPTIONS: Hash[String, ^(Hash[String, untyped]) -> Hash[String, untyped]]

  def self.challenge: () -> String
  def self.client: () -> WebAuthn::FakeClient
  def self.registration: (WebAuthn::FakeClient client, String challenge) -> Hash[String, untyped]
  def self.assertion: (WebAuthn::FakeClient client, String challenge) -> Hash[String, untyped]
  def self.sway_relying_party: () -> SwayRelyingParty
  def self.enroll: (WebAuthn::FakeClient client) -> WebAuthn::PublicKeyCredentialWithAttestation
  def self.enroll_user: (WebAuthn::FakeClient client) -> User
  def self.replace: (Hash[String, untyped] credential, Array[String] path, untyped value) -> Hash[String, untyped]
  def self.encode: (String bytes) -> String
  def self.decode: (String text) -> String
end

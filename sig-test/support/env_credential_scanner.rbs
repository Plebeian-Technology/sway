# spec/support/env_credential_scanner.rb.
#
# A real class rather than a spec-DSL helper, so it gets a real signature: the
# scanner is what stops the next .yml-hosted credential from being missed the
# way NEW_RELIC_LICENSE_KEY was, and a signature that said `untyped` would
# document none of the shape its two callers depend on.
class EnvCredentialScanner
  # One credential read, at the place it was found.
  class Read
    attr_reader path: String
    attr_reader line: Integer
    attr_reader name: String
    attr_reader source: String

    # Whether the read visibly goes through EnvSecret or strips inline. Named
    # without the `?` because #unstripped selects on it with `&:stripped`.
    attr_reader stripped: bool

    def initialize: (path: String, line: Integer, name: String, source: String, stripped: bool) -> void

    def to_s: () -> String
  end

  SKIPPED_PREFIXES: Array[String]
  SKIPPED_EXTENSIONS: Array[String]

  # path => the evidence for accepting that path's findings.
  EXEMPT_PATHS: Hash[String, String]

  READ_PATTERNS: Array[Regexp]
  APNS_FCM_AND_TWILIO_CREDENTIALS: Array[String]
  WEBAUTHN_CREDENTIALS: Array[String]
  EXTRA_CREDENTIALS: Array[String]

  # provisioned name => why it is not a credential the Rails process reads.
  NON_APP_CREDENTIALS: Hash[String, String]

  # credential name => why production is deliberately not given it. Read by the
  # credential-delivery examples in spec/config/deploy_yml_spec.rb.
  UNDELIVERED_CREDENTIALS: Hash[String, String]

  PUBLIC_PREFIXES: Array[String]
  CONTINUATION_WINDOW_LINES: Integer

  @credential_names: Array[String]?
  @reads: Array[Read]?

  def initialize: (?root: Pathname) -> void

  # Derived from .kamal/secrets, so a newly provisioned secret comes under the
  # guard without anyone adding it here.
  def credential_names: () -> Array[String]

  def reads: () -> Array[Read]

  # The reads that neither use the EnvSecret seam nor strip inline.
  def unstripped: () -> Array[Read]

  private

  attr_reader root: Pathname

  def provisioned: () -> Array[String]

  def scannable_paths: () -> Array[String]

  def reads_in: (String path) -> Array[Read]

  def credential_name_in: (String line) -> String?

  def pass_through?: (String line, String name) -> bool

  def assignment?: (String line, String name) -> bool

  def stripped?: (Array[String] lines, Integer index) -> bool
end

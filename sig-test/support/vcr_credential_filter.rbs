# spec/support/vcr_credential_filter.rb.
#
# A real module rather than an inline block in spec/support/vcr.rb, so it gets a
# real signature: the derivation is what stops the next credential from being
# recorded into a cassette the way LEGISTAR_API_KEY's dead filter failed to stop
# anything, and `untyped` would document none of the shape its caller depends
# on.
module VcrCredentialFilter
  # The shortest value the filter will substitute. Below it, a literal gsub
  # would collide with ordinary cassette text.
  MINIMUM_REDACTABLE_CHARS: Integer

  self.@credential_names: Array[String]?

  # Derived from EnvCredentialScanner, which derives it from .kamal/secrets.
  def self.credential_names: () -> Array[String]

  # Registers one lazy cassette placeholder per credential name.
  def self.apply!: (VCR::Configuration config) -> void

  # The value to scrub for `name`, or nil when there is nothing safe to scrub
  # (unset, blank, or shorter than MINIMUM_REDACTABLE_CHARS).
  def self.redactable_value: (String name) -> String?
end

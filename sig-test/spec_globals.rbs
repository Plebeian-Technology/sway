# Data migration under db/data/, likewise ignored by Steep. Same reason: the
# spec constructs it directly via .new and drives up/down.
class RetireUntestifiedDraftOrgPositions < ActiveRecord::Migration::Current
  def up: () -> void
  def down: () -> void

  # D-IN-03: the SQL half — rows that HOLD drafts. Still a Relation, because
  # the spec asserts the exact `!= '[]'` byte through #to_sql; that byte is
  # what the Rails/WhereNot autocorrect had rewritten away.
  def self.draft_bearing_rows: () -> BillLlmProvisioning::ActiveRecord_Relation

  # D-IN-03: the answer, and an Array rather than a Relation — the testimony
  # half of the predicate is asked in Ruby (#reject(&:testimony_present?))
  # because no portable SQL reproduces blank?'s whitespace handling. The spec
  # reads it with ActiveSupport's Enumerable#pluck, not the Relation one.
  def self.untestified_draft_rows: () -> Array[BillLlmProvisioning]
end


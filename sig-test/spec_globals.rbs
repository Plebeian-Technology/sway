module WebMock
  def self.disable_net_connect!: (**untyped) -> void
  # Phase 63 Plan 11 (fetch_hearings_service_spec.rb C12 two-run example):
  # not in the vendored .gem_rbs_collection webmock sig.
  def self.reset!: () -> void

  # B2-WR-07: the readable half of .disable_net_connect!. LiveLlmGate writes
  # `allow: [HOST]` only on the opted-in branch, so `allow` is nil in an
  # ordinary run — which is exactly what the gate spec asserts.
  class Config
    def self.instance: () -> WebMock::Config
    def allow: () -> Array[String]?
    def allow_localhost: () -> bool
  end

  # Returned by stub_request; asserted on with have_been_requested.
  class RequestStub
  end

  class RequestRegistry
    def self.instance: () -> WebMock::RequestRegistry
    def reset!: () -> void
  end
end


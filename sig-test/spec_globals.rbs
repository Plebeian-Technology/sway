class SeedLegislator
  # db/seeds/models/legislator.rb is not under a `check` target (only
  # db/seeds' consumers — specs — are checked), so its full instance API is
  # declared here rather than relying on the real .rb source.
  class MissingRegionCode < StandardError
  end

  class NonStateRegionCode < StandardError
  end

  # Raised when a single JSON row cannot be seeded (e.g. a required, NOT NULL
  # field is missing). Carries the locale + external_id so the offending row
  # is identifiable instead of aborting the run with an opaque DB/KeyError.
  class SeedError < StandardError
  end

  attr_reader prepared: untyped
  attr_reader sway_locale: untyped

  def initialize: (untyped json, untyped sway_locale, ?force: bool, ?locale_had_legislators: bool, ?official_service_result: untyped) -> void
  def self.run: (*untyped) -> untyped
  def self.read_legislators: (untyped sway_locale) -> untyped
  def self.district_name: (untyped region_code, untyped district) -> untyped
  def self.official_service_result_for: (untyped sway_locale) -> untyped
  def self.retire_unevidenced_executive_terms!: (untyped sway_locale, official_service_result: untyped, executive_preparers: untyped) -> untyped
  def seed: () -> untyped
  def legislator: () -> untyped
end

# @lat: [[signature-placement#Why a spec-only class is declared under sig-test]]
class SeedLegislatorTerms
  @legislator: Legislator
  @prepared: untyped

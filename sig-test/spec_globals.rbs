  def self.load_file: (String | Pathname path, **untyped) -> untyped
end

# Migration class — defined under db/migrate/, ignored by Steep. The spec
# constructs and runs the migration directly via .new.up, so declare the
# minimal shape here.
class AddSourceToLegislatorVotes < ActiveRecord::Migration::Current

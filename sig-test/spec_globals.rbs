module Seedable
  # What the seeder's guard needs of a record: whether it has ever been saved,
  # and the two times it compares — when a seed last wrote it, and when the row
  # last changed. A row edited by hand since the last seed is left alone.
  interface _Stampable
    def new_record?: () -> bool

    def last_seeded_at: () -> (Time | ActiveSupport::TimeWithZone)?

    def updated_at: () -> (Time | ActiveSupport::TimeWithZone)?
  end

  def seed_or_skip?: (_Stampable record, ?force: bool) -> bool
end

module VCR
  def self.configure: () { (untyped) -> untyped } -> untyped
  def self.use_cassette: (String name, **untyped opts) { () -> untyped } -> untyped
  def self.insert_cassette: (String name, **untyped opts) -> untyped
  def self.eject_cassette: () -> untyped

  # B2-WR-07: live_llm_network_gate_spec.rb asserts the ignored-host half of
  # the opt-in directly, because VCR refuses an uncassetted request BEFORE
  # WebMock's allowlist is consulted — so WebMock's half alone proves nothing.
  def self.request_ignorer: () -> VCR::RequestIgnorer

  # E-W-5: vcr_credential_filter_spec.rb runs VCR's OWN before_record hook
  # chain — `configuration.invoke_hook(:before_record, interaction.hook_aware,
  # cassette)`, the same call VCR::Cassette makes on the way to disk — rather
  # than a re-implementation of it, because a filter that is registered but
  # never invoked passes a mock and leaks in production. So the structs and
  # configuration surface that spec touches is declared here.
  #
  # Member names, order and arity follow vcr-6.4.0's lib/vcr/structs.rb (each
  # of these is a Struct.new(...) subclass with a normalizing #initialize).
  # Members no spec reads — Response#adapter_metadata, HTTPInteraction
  # #recorded_at — are left undeclared rather than guessed at.
  def self.configuration: () -> VCR::Configuration

  # Struct.new(:method, :uri, :body, :headers) / (:status, :headers, :body,
  # ...): a header set is a multimap, one Array of values per field name.
  type header_map = Hash[String, Array[String]]

  class Configuration
    # VCR::Hooks#invoke_hook. Declared at the :before_record shape, which is
    # the one the suite drives. `-> void`: the value is the collected return
    # of every registered hook lambda — the hook author's business, and not
    # part of the surface this shim exists to pin.
    def invoke_hook: (Symbol hook_type, VCR::HTTPInteraction::HookAware interaction, VCR::Cassette cassette) -> void

    # The registration half of the same feature: VcrCredentialFilter.apply!
    # calls this once per provisioned credential. `filter_sensitive_data` is
    # the documented spelling and an alias of #define_cassette_placeholder in
    # the gem (configuration.rb:237), so both are declared.
    #
    # The block is optional-arity at runtime (VCR#call_block dispatches on
    # Proc#arity), and our call sites take none; the yielded HookAware is
    # declared optional to match. A nil return is inert — VCR gsubs on the
    # stringified value and HookAware#filter! no-ops on "".
    def define_cassette_placeholder: (String placeholder, ?Symbol? tag) { (?VCR::HTTPInteraction::HookAware interaction) -> String? } -> void

    alias filter_sensitive_data define_cassette_placeholder
  end

  class Request
    def initialize: (Symbol method, String uri, ?String? body, ?VCR::header_map? headers) -> void
    def method: () -> Symbol
    def uri: () -> String
    def body: () -> String?
    def headers: () -> VCR::header_map?
  end

  class ResponseStatus
    def initialize: (Integer code, ?String? message) -> void
    def code: () -> Integer
    def message: () -> String?
  end

  class Response
    def initialize: (VCR::ResponseStatus status, ?VCR::header_map? headers, ?String? body, ?String? http_version) -> void
    def status: () -> VCR::ResponseStatus
    def headers: () -> VCR::header_map?
    def body: () -> String?
  end

  class HTTPInteraction
    def initialize: (VCR::Request request, VCR::Response response, ?Time recorded_at) -> void
    def request: () -> VCR::Request
    def response: () -> VCR::Response
    def hook_aware: () -> VCR::HTTPInteraction::HookAware

    # At runtime this is `DelegateClass(HTTPInteraction)` plus ignore!/ignored?
    # and #filter!. RBS cannot express DelegateClass, and a subclass is the
    # closest true statement about the surface: every reader below resolves on
    # it, by delegation rather than inheritance.
    class HookAware < HTTPInteraction
      def ignore!: () -> void
      def ignored?: () -> bool
      def filter!: (String? text, String? replacement_text) -> void
    end
  end

  class Cassette
    def name: () -> String
    def tags: () -> Array[String]
  end

  class RequestIgnorer
    def ignore?: (VCR::Request request) -> bool
  end
end

# spec/lib/env_secret_call_sites_spec.rb boots config/boot.rb in a subprocess
# with a dirty environment. The rbs shim for Bundler covers the lockfile API
# only, so the env-scrubbing half is declared here.
module Bundler
  def self.with_unbundled_env: [T] () { () -> T } -> T
end

# gem_rbs_collection's net-smtp/0.5 signature is missing the two keywords
# config/environments/production.rb actually passes. net-smtp 0.5.1's real
# `SMTP.start` takes `secret:` and `authtype:` (smtp.rb:539-543); the
# collection declares `password:` and `auth_type:`, the latter of which is not
# a keyword at all — it is the name of the fourth POSITIONAL in its legacy
# overload. A call spelled the way production spells it therefore matched no
# keyword overload and fell through to the positional one, where the whole
# kwargs Hash was read as `helo`.
#
# Declared to net-smtp 0.5.1's real keyword list, with `| ...` retaining the
# collection's overloads for the positional callers. `ssl_context_params:` is
# omitted rather than typed: its value is forwarded verbatim to
# OpenSSL::SSL::SSLContext#set_params and nothing in this suite passes it.
class Net::SMTP
  def self.start: (String address, ?Integer port,
                   ?helo: String?, ?user: String?, ?secret: String?, ?password: String?,
                   ?authtype: Symbol?, ?tls: bool, ?starttls: (Symbol | bool),
                   ?tls_verify: bool, ?tls_hostname: String?) -> instance
                | [T] (String address, ?Integer port,
                       ?helo: String?, ?user: String?, ?secret: String?, ?password: String?,
                       ?authtype: Symbol?, ?tls: bool, ?starttls: (Symbol | bool),
                       ?tls_verify: bool, ?tls_hostname: String?) { (instance) -> T } -> T
                | ...
end

# newrelic_rpm ships no RBS and has no gem_rbs_collection entry. Declared to
# the extent spec/lib/env_secret_call_sites_spec.rb exercises it: that spec
# keeps "the agent reads NEW_RELIC_LICENSE_KEY out of ENV unstripped, and
# orders that source above the yaml" as an executable claim rather than prose.
module NewRelic
  module Agent
    module Configuration
      # < ::Hash in the gem. Symbol-keyed (DottedHash.symbolize does that in
      # the constructor); the values are whatever a config key is declared to
      # hold — String, Integer, Float, bool, Array, Proc — so `top` states
      # "some value, narrow it before use" without the blanket permission
      # `untyped` would hand every caller.
      class DottedHash < ::Hash[Symbol, top]
      end

      class EnvironmentSource < DottedHash
        def initialize: () -> void
      end

      # Reached only through `instance_method(:config_stack)` — the spec reads
      # the method's SOURCE to pin the source ordering, and never calls it. So
      # the class is declared and its private innards are not.
      class Manager
      end
    end
  end
end


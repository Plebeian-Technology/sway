  attr_reader prepared: untyped
  attr_reader first_sighting: bool
  attr_reader observed_on: Date

  def add_missing_terms!: () -> void
  def current_term_attrs: () -> Hash[Symbol, untyped]
  def create_term!: (Hash[Symbol, untyped] term_attrs) -> void
  def stamp_observed_start!: (LegislatorTerm term) -> void
  def correct_terms!: () -> void
  def retire_unproven_terms!: () -> void
  def stored_terms: () -> Array[LegislatorTerm]
  def proven_by_start_year: () -> Hash[Integer, Hash[Symbol, untyped]]
end

# db/seeds/seed_preparers/legislators/{base,congress_dot_gov,open_states,sway}.rb
# — same not-under-`check` situation as SeedLegislator above. Declared
# concretely (not `def self.new: (*untyped) -> untyped`) so
# seed_legislator_spec.rb's direct preparer-level specs (term_start_year /
# term_end_year / authoritative_term? / etc.) type-check against real return
# shapes rather than swallowing everything into untyped.
module SeedPreparers
  module Legislators
    class Base
      attr_reader json: untyped
      attr_reader sway_locale: untyped

      def initialize: (untyped json, untyped sway_locale) -> void
      def district: () -> untyped
      def phone: () -> untyped
      def email: () -> untyped
      def twitter: () -> untyped
      def link: () -> untyped
      def external_id: () -> untyped
      def identity: () -> LegislatorIdentity?
      def current_member?: () -> bool
      def title: () -> untyped
      def party: () -> untyped
      def first_name: () -> untyped
      def last_name: () -> untyped
      def country: () -> String
      def region_code: () -> untyped
      def postal_code: () -> untyped
      def photo_url: () -> untyped
      def term_start_year: () -> Integer
      def term_end_year: () -> Integer
      def authoritative_term?: () -> bool
      def proven_terms: () -> Array[Hash[Symbol, untyped]]
      def terms_from_history?: () -> bool
      def executive?: () -> bool
      def congress?: () -> bool
    end

    class CongressDotGov < Base
      def potus?: () -> bool
      def executive?: () -> bool
      def current_member?: () -> bool
      def terms_from_history?: () -> bool
      def current_office_identity: () -> String?
    end

    class OpenStates < Base
      MARYLAND_TERM_ANCHOR_YEAR: Integer
      MARYLAND_TERM_CYCLE_LENGTH: Integer
    end

    class Sway < Base
      BALTIMORE_TERM_ANCHOR_YEAR: Integer
      BALTIMORE_TERM_CYCLE_LENGTH: Integer
    end
  end
end

# spec/config/recurring_spec.rb — the `fugit` gem parses solid_queue's
# recurring.yml cron schedules. No RBS collection entry exists for it, so a
# minimal shim covers the two call sites the spec exercises.
module Fugit
  class Cron
    def next_time: (*untyped) -> untyped
  end

  # Returns untyped (not `Fugit::Cron?`) — the spec dereferences the parsed
  # result directly after an `expect(...).not_to be_nil` assertion, with no
  # narrowing annotation; a nilable return here would just relocate the
  # NoMethod error onto `parsed.next_time` instead of resolving it.
  def self.parse: (untyped) -> untyped
end


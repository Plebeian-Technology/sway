  def approved_bna: () -> BillNewsArticle
  def excerpt: () -> String
  def valid_source_uses: () -> Array[Hash[Symbol, untyped]]
  def legacy_revision: () -> BillSummaryRevision
  def build_custom_batch_result: (Bill, Hash[String, untyped]) -> Llm::ClaudeBatchService::Result

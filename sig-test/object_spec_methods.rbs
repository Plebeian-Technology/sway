    # top-level WebMock stub helpers (moved from the nested "attachment
    # discovery" describe block in Plan 11 so "attachment download"/
    # "attachment extraction" can reuse them; matter_id: added so the
    # backfill-mode describe block can stub non-default matter ids).
    # Legistar's answer when the backfill asks for one bill by its
    # file number, and one row of that answer.
    def stub_named_lookup: (String external_id, Array[Hash[String, untyped]] matters) -> untyped
    def matter_row: (String external_id, Integer matter_id) -> Hash[String, untyped]
    def stub_event_items: (Integer event_id, Array[Hash[String, untyped]] items, ?status: Integer) -> untyped
    # A4-WR-04: `body` is serialized straight to JSON as the response body, so
    # its honest type is "any JSON array" — NOT Array[Hash]. The narrow type was
    # an accident of only ever having stubbed well-formed rows, and it
    # contradicted the existence of the spec that stubs [nil, {...}, 42] to
    # prove #fetch_matter_attachments drops non-Hash elements instead of
    # raising. Widening here states what the helper actually accepts rather
    # than asserting a guarantee Legistar does not make.
    def stub_matter_attachments: (Array[untyped] body, ?status: Integer, ?matter_id: Integer) -> untyped
    def stub_matter_histories: (Array[Integer] event_ids, ?status: Integer, ?matter_id: Integer) -> untyped
    # fetch_hearings_service_spec.rb, "#call — an unread COLLECTION makes the
    # sweep non-authoritative (A-CR-01)": two `def`s inside that describe
    # block. `-> void` rather than the sibling stubs' `untyped` because the
    # WebMock::RequestStub it returns is never used by a caller.
    def stub_bill_text_event_item: (Integer event_id, Integer attachment_id) -> void

    def attach_photo: (Legislator record) -> void

    # B22-01: summary_run_arm_decision_spec.rb. Names chosen so each says what
    # it holds, since this shim declares ONE signature per method name for the
    # whole suite — and so the two clocks cannot be read for each other. Both
    # are `updated_at`, the abandonment clock; neither is the stale gate's
    # `enqueued_at`, which is re-stamped on every retry.
    def this_job_id: () -> String
    def live_clock: () -> ActiveSupport::TimeWithZone
    def abandoned_clock: () -> ActiveSupport::TimeWithZone
    def decision: () -> SummaryRunArmDecision
    def arm_decision: (
      status_at_load: String?,
      status: String?,
      ?marker: String?,
      ?updated_at: ActiveSupport::TimeWithZone?,
    ) -> SummaryRunArmDecision

    # B23-02: the two def-in-describe builders for a row a dead worker left
    # behind — reclaim_abandoned_summary_runs_job_spec.rb and
    # bill_llm_provisioning_spec.rb. Both write generation_status and updated_at
    # through update_all, because updated_at is the input under test and a
    # callback would bump it back to now.
    #
    # `abandoned_clock` is shared with summary_run_arm_decision_spec above and
    # means the same thing there: `updated_at` past RECLAIM_ABANDONED_AFTER,
    # never the stale gate's `enqueued_at`. Names are otherwise specific,
    # because this shim declares ONE signature per method name for the whole
    # suite.
    def stranded_provisioning: (
      String status,
      ?updated_at: ActiveSupport::TimeWithZone?,
      ?llm_summary: String?,
      ?llm_generated_at: ActiveSupport::TimeWithZone?,
    ) -> BillLlmProvisioning
    def reclaimable_row_with: (
      String status,
      updated_at: ActiveSupport::TimeWithZone,
      ?llm_summary: String?,
      ?llm_generated_at: ActiveSupport::TimeWithZone?,
      ?summary_batch_expires_at: ActiveSupport::TimeWithZone?,
      ?bill: Bill?,
    ) -> BillLlmProvisioning

    # A quiet row a live batch still owns, built two ways under one shape.
    def quiet_batch_row: (
      summary_batch_expires_at: ActiveSupport::TimeWithZone?,
      ?status: String,
    ) -> BillLlmProvisioning
    def batch_owned_provisioning: (
      summary_batch_expires_at: ActiveSupport::TimeWithZone?,
    ) -> BillLlmProvisioning

    # The expiry the stubbed submit reports back, and the chunks it was handed.
    def batch_expires_at: () -> ActiveSupport::TimeWithZone
    def submitted_chunks: () -> Array[Array[Llm::ClaudeBatchService::Item]]

    # B24-02: the same stranded row, carrying an operator-paste marker — the
    # deferred hand-off PasteSummaryService promised and a dead worker never
    # kept. reclaim_abandoned_summary_runs_job_spec.rb.
    def pasted_provisioning: (String status) -> BillLlmProvisioning

    # generate_bill_summary_job_spec.rb's auto-publish runner: one stubbed payload, one job run.
    def run_publish_summary_job: (Hash[String, untyped] payload) -> untyped

    # bill_creator_run_pin_redirects_spec.rb: the three helpers that drive a
    # Bill Creator write from an address holding ?run_id= and read the pin back
    # off the redirect.
    def summary_address: (Integer id, ?String? query) -> String

    def generate_summary_from: (String referer) -> untyped

    def redirect_query: () -> Hash[String, String]

    # sway_locale_id_param_spec.rb. `cookies` is the request-spec jar: the
    # examples both seed it (a browser arriving with a stale jurisdiction) and
    # read it back (whether the request wrote one). ActionDispatch's own
    # signature already declares [], []= and delete on it, so this only has to
    # say which object the bare method returns.
    def cookies: () -> ActionDispatch::Cookies::CookieJar

    # The jurisdiction id currently in that jar, or nil when none was written.
    def locale_cookie: () -> String?

    # An id chosen so that no SwayLocale row can hold it.
    def missing_locale_id: () -> Integer

    # github_pr_service_spec.rb: the one place naming the seam the local
    # `git config` read goes through. The block answers as
    # Sway::Subprocess.capture3 does — [stdout, stderr, status] — or raises to
    # stand for "this must not be called".
    def stub_git_remote: () { (*untyped) -> untyped } -> untyped

    # admin_setting_spec.rb: the singleton settings row, and a model name that
    # was taken off the allowed list while the row still names it.
    def setting: () -> AdminSetting

    def retired_model: () -> String

    # bills/categories_spec.rb: the Bill Creator summary tab as a full address, scheme and host included.
    def summary_bill_creator_url: (*untyped args, **untyped kwargs) -> String

    # The address those examples arrive from and expect to land back on.
    def referer: () -> String

    # seed_legislator_spec.rb: Baltimore's roster is keyed by seat,
    # so a row's external_id is the seat and the published name together. These
    # two build that value from a roster entry and find the row under it.
    def seat_and_name_key: (Hash[String, untyped] entry) -> String

    def baltimore_row_for: (Hash[String, untyped] entry) -> Legislator?

    # seed_legislator_spec.rb: the committed curated President row and the
    # current terms in its locale-wide district.
    def curated_potus_json: () -> Hash[String, untyped]
    def current_president_terms: () -> Array[LegislatorTerm]


    # answers with, and withdraw_testimony is the concurrent fetch-hearings
    # :retract driven as a separate UPDATE.
    def marked_draft: () -> Hash[String, String]
    def fresh_positions: () -> Hash[String, Array[Hash[String, String]]]
    def withdraw_testimony: () -> untyped

    # B20-04: the same concurrent withdrawal, driven from Llm::Client.build so
    # it lands inside the retry's own window — after #positions_owed? said the
    # positions call was owed and before the locked read that decides to make

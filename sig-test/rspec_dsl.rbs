    def have_css: (*untyped args, **untyped kwargs) -> untyped
    def build:
        (*untyped args, **untyped kwargs) -> untyped
        | (*untyped args, **untyped kwargs) { (*untyped args) -> untyped } -> untyped
    def spy: (*untyped args, **untyped kwargs) -> untyped
    def hash_including: (*untyped args, **untyped kwargs) -> untyped

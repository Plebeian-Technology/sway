module RSpec
    def self.describe:
        (*untyped args, **untyped kwargs) -> untyped
        | (*untyped args, **untyped kwargs) { (*untyped args) -> untyped } -> untyped
    def self.configure: { (RSpec::Core::Configuration config) -> untyped } -> untyped
    def self.configuration: -> RSpec::Core::Configuration
    def self.shared_context:
        (*untyped args, **untyped kwargs) -> untyped
        | (*untyped args, **untyped kwargs) { (*untyped args, **untyped kwargs) -> untyped } -> untyped

    module Expectations
        class ExpectationNotMetError < StandardError
        end

        # What expect(value) and expect { } return.
        class ExpectationTarget
            def to: (*untyped args, **untyped kwargs) ?{ (*untyped args, **untyped kwargs) -> untyped } -> untyped
            def not_to: (*untyped args, **untyped kwargs) ?{ (*untyped args, **untyped kwargs) -> untyped } -> untyped
            def to_not: (*untyped args, **untyped kwargs) ?{ (*untyped args, **untyped kwargs) -> untyped } -> untyped
        end
    end

    # C-CR-03: requires_sway_admin.rb re-raises RSpec's own failures ahead of
    # its bare `rescue`, and the Mocks half was undeclared — steep reported
    # "Cannot find the declaration of constant: Mocks".
    #
    # `< Exception`, not `< StandardError`: rspec-mocks defines it as
    # `MockExpectationError = Class.new(Exception)` (verified against the
    # installed gem), which is precisely why the explicit re-raise clause is
    # load-bearing documentation rather than dead defensiveness — a bare
    # `rescue` would never have swallowed it, while ExpectationNotMetError
    # (a real StandardError) would have been.
    module Mocks
        class MockExpectationError < Exception
        end

        # What allow, allow_any_instance_of and expect_any_instance_of return.
        class TargetBase
            def to: (*untyped args, **untyped kwargs) ?{ (*untyped args, **untyped kwargs) -> untyped } -> untyped
            def not_to: (*untyped args, **untyped kwargs) ?{ (*untyped args, **untyped kwargs) -> untyped } -> untyped
            def to_not: (*untyped args, **untyped kwargs) ?{ (*untyped args, **untyped kwargs) -> untyped } -> untyped
        end

        class AllowanceTarget < TargetBase
        end

        class AnyInstanceAllowanceTarget < TargetBase
        end

        class AnyInstanceExpectationTarget < TargetBase
        end

        module Matchers
            # What receive(:name) returns; every customization returns the matcher.
            class Receive
                def and_return: (*untyped values) -> self
                def and_invoke: (*untyped procs) -> self
                def and_call_original: () -> self
                def and_wrap_original: () ?{ (*untyped args, **untyped kwargs) -> untyped } -> self
                def and_yield: (*untyped args) -> self
                def and_raise: (*untyped args) -> self
                def and_throw: (*untyped args) -> self
                def with: (*untyped args, **untyped kwargs) ?{ (*untyped args, **untyped kwargs) -> untyped } -> self
                def once: () -> self
                def twice: () -> self
                def thrice: () -> self
                def never: () -> self
                def ordered: () -> self
                def exactly: (untyped n) -> self
                def at_least: (untyped n) -> self
                def at_most: (untyped n) -> self
                def times: () -> self
                def time: () -> self
            end
        end
    end
end

module FactoryBot
    def self.define: { (*untyped args) -> untyped } -> untyped
    def self.create: (*untyped args, **untyped kwargs) -> untyped
    def self.build: (*untyped args, **untyped kwargs) -> untyped
    def self.create_list: (*untyped args, **untyped kwargs) -> untyped
    def self.build_stubbed: (*untyped args, **untyped kwargs) -> untyped
    def self.attributes_for: (*untyped args, **untyped kwargs) -> untyped
end


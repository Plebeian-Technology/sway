            (Symbol, *untyped args, **untyped kwargs) -> untyped
            | (Symbol, *untyped args, **untyped kwargs) { (*untyped args) -> untyped } -> untyped
        def respond_to_missing?: (Symbol, ?bool include_private) -> bool
    end
end

module RSpec
    module Core
        module SharedContext
            def let: (Symbol name) { -> untyped } -> untyped
            def before:
                (*untyped args, **untyped kwargs) -> untyped
                | (*untyped args, **untyped kwargs) { (*untyped args) -> untyped } -> untyped
            def allow: (untyped value) -> RSpec::Mocks::AllowanceTarget
            def instance_double: (*untyped args, **untyped kwargs) -> untyped
            def receive: (*untyped args, **untyped kwargs) -> RSpec::Mocks::Matchers::Receive
                       | (*untyped args, **untyped kwargs) { (*untyped args, **untyped kwargs) -> untyped } -> RSpec::Mocks::Matchers::Receive
            def method_missing: (Symbol, *untyped args, **untyped kwargs) -> untyped
            def respond_to_missing?: (Symbol name, ?bool include_private) -> bool
        end

        class Configuration
            def `include`: (*untyped args, **untyped kwargs) -> untyped
            def fixture_paths=: (untyped value) -> untyped
            def use_transactional_fixtures=: (bool value) -> bool
            def expect_with:
                (*untyped args, **untyped kwargs) -> untyped
                | (*untyped args, **untyped kwargs) { (*untyped args) -> untyped } -> untyped
            def mock_with:
                (*untyped args, **untyped kwargs) -> untyped
                | (*untyped args, **untyped kwargs) { (*untyped args) -> untyped } -> untyped
            def shared_context_metadata_behavior=: (untyped value) -> untyped
            def infer_spec_type_from_file_location!: -> untyped
            def filter_rails_from_backtrace!: -> untyped
            def before:
                (*untyped args, **untyped kwargs) -> untyped
                | (*untyped args, **untyped kwargs) { (*untyped args) -> untyped } -> untyped
            def around:
                (*untyped args, **untyped kwargs) -> untyped
                | (*untyped args, **untyped kwargs) { (*untyped args) -> untyped } -> untyped
            # spec/rails_helper.rb uses prepend_before / append_after to gate
            # system-spec transactional behavior + post-test truncation. Both
            # are part of the RSpec::Core::Configuration hook DSL; same shape
            # as before/around above.
            def prepend_before:
                (*untyped args, **untyped kwargs) -> untyped
                | (*untyped args, **untyped kwargs) { (*untyped args) -> untyped } -> untyped
            # spec/support/production_snapshot.rb excludes the
            # snapshot-gated specs unless RUN_PROD_DB_TESTS=1.
            def filter_run_excluding: (*untyped args, **untyped kwargs) -> untyped
            def append_after:
                (*untyped args, **untyped kwargs) -> untyped
                | (*untyped args, **untyped kwargs) { (*untyped args) -> untyped } -> untyped
            def reporter: -> untyped
            def order=: (Symbol | String value) -> (Symbol | String)
            def seed: -> Integer
        end
    end
end

module Capybara
    module Selenium
        class Driver
            def self.load_selenium: -> untyped
            def initialize: (
                untyped app,
                ?browser: Symbol,
                ?options: untyped,
                ?service: untyped,
                ?clear_local_storage: bool,
                ?clear_session_storage: bool
            ) -> void

            # The three the guards in spec/support/system_driver.rb wrap.
            def reset!: () -> void
            def quit: () -> void
            def save_screenshot: (*untyped args, **untyped kwargs) ?{ (*untyped args) -> untyped } -> untyped

            class ChromeDriver < Driver
            end
        end
    end

    class Session
        def driver: -> untyped
        def reset!: () -> void
        def quit: () -> void
    end

    class ElementNotFound < StandardError
    end

    def self.register_driver: (*untyped args, **untyped kwargs) { (*untyped args) -> untyped } -> untyped
    def self.configure: { (untyped config) -> untyped } -> untyped
    def self.ignore_hidden_elements=: (bool value) -> bool
    def self.reset_sessions!: -> untyped
    def self.server_host: -> String?
    def self.server_host=: (String? host) -> String?
    def self.app_host: -> String?
    def self.app_host=: (String? host) -> String?
    def self.always_include_port: -> bool
    def self.always_include_port=: (bool value) -> bool
    def self.default_max_wait_time=: (untyped value) -> untyped
end

module CapybaraHelpers
    SCREENSHOT_DIR: String?
    SECONDS_TO_WAIT: Integer

    def reset_browser_state: -> untyped
    def clear_browser_storage: -> untyped
    def wait_until_loaded: -> untyped
    def open_category_filter: -> untyped
    def toggle_category: (String name) -> untyped
    def wait_until: (?Float delay) { -> untyped } -> untyped
    def wait_for: (String selector, **untyped options) ?{ (untyped element) -> untyped } -> untyped
end

module VirtualAuthenticator
    type cdp_primitive = String | Integer | bool | nil
    type cdp_value = cdp_primitive | Array[cdp_value] | Hash[Symbol, cdp_value]

    interface _CdpBrowser
        def execute_cdp:
            (String command) -> Hash[String, cdp_value]
            | (String command, **cdp_value params) -> Hash[String, cdp_value]
    end

    def enable_virtual_authenticator: -> String
    def disable_virtual_authenticator: (String id) -> top?
    def execute_cdp: (_CdpBrowser browser, String command, ?Hash[Symbol, cdp_value]? params) -> Hash[String, cdp_value]
end

module Selenium
    module WebDriver
        module Service
            def self.chrome: (*untyped args, **untyped kwargs) -> untyped
        end

        module Error
            class WebDriverError < StandardError
            end

            class NoSuchDriverError < WebDriverError
            end

            # The four spec/support/system_driver.rb reads as "the browser is gone".
            class NoSuchSessionError < WebDriverError
            end

            class InvalidSessionIdError < WebDriverError
            end

            class SessionNotCreatedError < WebDriverError
            end

            class UnknownError < WebDriverError
            end

            class ElementNotInteractableError < WebDriverError
            end

            class ElementClickInterceptedError < WebDriverError
            end
        end

        module Chrome
            class Options
                def add_argument: (String arg) -> untyped
            end
        end
    end
end

class ActionMailer::Base
    def self.deliveries: -> Array[untyped]
end


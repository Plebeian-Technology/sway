# Copy this file to sway.env and put your own values in it:
#
#   cp deploy/config/sway.env.example deploy/config/sway.env
#
# sway.env is ignored by git. It holds the addresses, disk paths and account
# names that belong to your installation and to nobody else's, which is why
# they are not in the repo.
#
# Every value can also be set as an ordinary environment variable, and doing so
# wins over this file. That is how one deploy goes somewhere else without any
# file being edited:
#
#   SWAY_HOST=10.0.0.11 ./scripts/deploy.sh
#
# Nothing is guessed. Leave a value out and the run stops and names it.
#
# The values below are examples. None of them will work.


# ---------------------------------------------------------------------------
# The machine that serves the site
# ---------------------------------------------------------------------------

# Where deploys go. An address or a name this machine can reach.
SWAY_HOST=10.0.0.10

# The serving machine's optional Tailscale address used to bind private operator
# services such as Beszel in addition to SWAY_HOST. Leave it out if Tailscale is
# not running on the serving machine.
SWAY_TAILSCALE_IP=100.64.0.10

# The folder ON THAT MACHINE holding the SQLite database files. It must be on
# the removable disk, not the memory card. Docker will happily create an empty
# folder if this is wrong, and the app will then seed a blank database over the
# top of nothing and report success.
SWAY_STORAGE_DIR=/mnt/ssd/sway/storage

# The account deploys log in as, and the private key that logs it in.
SWAY_DEPLOY_USER=deploy
SWAY_SSH_KEY=~/.ssh/sway_deploy


# ---------------------------------------------------------------------------
# The image store
# ---------------------------------------------------------------------------

# Where built images are uploaded to and downloaded from. A registry without
# authentication or TLS is only safe on a network you trust; set this and the
# registry credentials in .kamal/secrets-common to match yours. A plain-HTTP
# registry must be listed as allowed in Docker — see docs/operations.md.
SWAY_REGISTRY=registry.example.local:5000


# ---------------------------------------------------------------------------
# The Google account holding backups and uploaded files
# ---------------------------------------------------------------------------

# A WRONG VALUE HERE IS THE DANGEROUS KIND. Backups would upload to a bucket
# nobody reads, every run would report success, and nobody would find out until
# a restore was needed. Production checks all of these while it starts, so a
# missing one stops the boot rather than waiting to be discovered.

SWAY_GCP_PROJECT_ID=your-project-id

# Holds the database copies. Two separate lineages live in it: the continuous
# stream under SWAY_LITESTREAM_PATH, and the every-6-hours snapshots.
SWAY_GCS_BUCKET_DB=your-project-sqlite

# Holds pictures and other files uploaded through the site.
SWAY_GCS_BUCKET_ASSETS=your-project-assets

# Optional. Browser origins, beyond localhost and the production names, that may
# upload straight to the assets bucket — a dev tunnel or preview host. Comma
# separated. Applied by SwayGoogleCloudStorage.configure.
# SWAY_GCS_EXTRA_CORS_ORIGINS=https://dev.example.com,https://preview.example.com

# Holds legislation pipeline artifacts copied off the production machine.
SWAY_GCS_BUCKET_LEGISLATION=your-project-legislation

# The folder inside SWAY_GCS_BUCKET_DB that the continuous copy writes to.
SWAY_LITESTREAM_PATH=litestream/production

# The sign-in file ON THE SERVING MACHINE. scripts/provision-litestream-key.sh
# puts it there out of Bitwarden; it is never written into this repo.
SWAY_KEYFILE_PATH=/home/deploy/litestream/gcs-key.json


# ---------------------------------------------------------------------------
# Addresses the app is willing to answer to
# ---------------------------------------------------------------------------

# Rails rejects a request whose Host header is not on this list, before any
# application code runs. Public names plus any address you reach it by on your
# own network. Comma separated.
RAILS_ALLOWED_HOSTS=sway.vote,app.sway.vote,www.sway.vote,10.0.0.10

# The same idea for `dip run dev`. Leave it out unless you reach the dev server
# by an address rather than by localhost.
SWAY_DEV_ALLOWED_HOSTS=10.0.0.5

# Optional. The public hostname of your own Cloudflare tunnel for `dip run dev`
# (config/cloudflared.key holds its token). Unset means localhost only.
# DEV_TUNNEL_HOST=dev.example.com

# Optional. The public hostname of your tunnel for `dip run preview`; added to
# the preview's allowed hosts. Unset means localhost only.
# PREVIEW_HOST=preview.example.com


# ---------------------------------------------------------------------------
# The mobile app
# ---------------------------------------------------------------------------

# Optional. The SHA-256 fingerprints of your Android app's signing
# certificates — both the upload key and the Play-signed key — comma separated,
# each one colon-delimited hex. Published at /.well-known/assetlinks.json so
# Android trusts your app with your site's links and passkeys. Leave it out if
# you ship no Android app: the list is then published empty, with a warning.
SWAY_ANDROID_CERT_SHA256_FINGERPRINTS=AA:BB:CC:DD:EE:FF:00:11:22:33:44:55:66:77:88:99:AA:BB:CC:DD:EE:FF:00:11:22:33:44:55:66:77:88:99

# The numeric id App Store Connect issues when the app record is created,
# shown under App Information. The marketing page drops the App Store badge
# rather than emit a dead link until this is set. Leave it out if you ship no
# iOS app.
SWAY_APPLE_APP_STORE_ID=1234567890


# ---------------------------------------------------------------------------
# The standby machine
# ---------------------------------------------------------------------------
# A second machine that keeps its own copy of the database, fetched from the
# cloud copy on a daily timer. Every run is also a live test of the restore
# path. See docs/litestream-restore.md. Leave these out if you have no second
# machine — nothing else needs them.

SWAY_STANDBY_HOST=10.0.0.11

# The folder the copy is kept in, and the mount point it must sit inside. The
# mount point is checked separately and on purpose: without that check the copy
# lands on the boot disk, fills it, and reports success.
SWAY_STANDBY_DIR=/mnt/ssd/sway/standby
SWAY_STANDBY_MOUNT=/mnt/ssd


# ---------------------------------------------------------------------------
# Practice machine
# ---------------------------------------------------------------------------
# To rehearse a deploy, write a config/deploy.<name>.yml for the practice
# machine and add its own values here. It needs its own disk and its own place
# to copy to; scripts/deploy.sh refuses a practice run that shares either with
# the machine serving the public.

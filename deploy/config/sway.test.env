# Values used when RAILS_ENV=test. THIS FILE IS TRACKED BY GIT, on purpose.
#
# The test suite must run the same way on every machine, so it cannot read
# anybody's real addresses or account names. It reads these instead.
#
# Every value here is deliberately fake. The addresses end in .invalid, which
# is a reserved ending that can never resolve to a real machine, so a test that
# accidentally reaches the network fails loudly rather than touching something
# that exists.
#
# Nothing here is a credential and nothing here needs guarding. If a test needs
# a REAL value, that test is asking the wrong question — see
# spec/lib/sway_deploy_config_spec.rb.
#
# SwayDeployConfig picks this file over deploy/config/sway.env whenever
# RAILS_ENV or RACK_ENV is "test".

SWAY_HOST=sway-test.invalid
SWAY_TAILSCALE_IP=sway-tailscale-test.invalid
SWAY_STORAGE_DIR=/tmp/sway-test/storage
SWAY_DEPLOY_USER=test-deploy
SWAY_SSH_KEY=/tmp/sway-test/ssh-key

SWAY_REGISTRY=registry-test.invalid:5000

SWAY_GCP_PROJECT_ID=sway-test-project
SWAY_GCS_BUCKET_DB=sway-test-sqlite
SWAY_GCS_BUCKET_ASSETS=sway-test-assets
SWAY_GCS_BUCKET_LEGISLATION=sway-test-legislation
SWAY_LITESTREAM_PATH=litestream/test
SWAY_KEYFILE_PATH=/tmp/sway-test/gcs-key.json

RAILS_ALLOWED_HOSTS=sway-test.invalid
SWAY_DEV_ALLOWED_HOSTS=sway-test.invalid

SWAY_ANDROID_CERT_SHA256_FINGERPRINTS=00:00:00:00:00:00:00:00:00:00:00:00:00:00:00:00:00:00:00:00:00:00:00:00:00:00:00:00:00:00:00:01

SWAY_STANDBY_HOST=sway-standby-test.invalid
SWAY_STANDBY_DIR=/tmp/sway-test/standby
SWAY_STANDBY_MOUNT=/tmp/sway-test

SWAY_APPLE_APP_STORE_ID=1234567890

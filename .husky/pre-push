#!/usr/bin/env sh
# husky pre-push — scan the commits being pushed for secrets (gitleaks).
#
# Backstop for the pre-commit gate: catches anything that reached a commit via
# `--no-verify`, an amend, or a rebase. Husky feeds the pre-push stdin through
# to this script: one line per ref as "<local ref> <local sha> <remote ref> <remote sha>".
set -eu

is_zero() { case "$1" in *[!0]*) return 1 ;; *) return 0 ;; esac; }

status=0
while read -r _local_ref local_sha _remote_ref remote_sha; do
  [ -z "${local_sha:-}" ] && continue
  is_zero "$local_sha" && continue          # branch deletion — nothing to scan

  if is_zero "$remote_sha"; then
    # New branch on the remote: scan commits unique to what we're pushing.
    range="$local_sha --not --remotes"
  else
    range="$remote_sha..$local_sha"
  fi

  echo "secret-scan: scanning $range"
  bin/secret-scan.sh range "$range" || status=1
done

if [ "$status" -ne 0 ]; then
  echo "secret-scan: potential secret(s) in the pushed commits — push blocked." >&2
  echo "  Bypass once (deliberate):  SWAY_SKIP_SECRET_SCAN=1 git push ..." >&2
fi
exit "$status"
